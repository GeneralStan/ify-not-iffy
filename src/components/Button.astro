---
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary';
  icon?: 'none' | 'leading' | 'trailing';
  newTab?: boolean;
  /** No-icon buttons grow into their Trailing Icon variant on hover (on by default). */
  morph?: boolean;
  /** Opens the Cal.com booking modal (src/scripts/cal.ts) instead of following the link. */
  cal?: boolean;
  class?: string;
}

const {
  href,
  label,
  variant = 'primary',
  icon = 'none',
  newTab = false,
  morph = icon === 'none',
  cal = false,
  class: className,
} = Astro.props;
const morphs = icon === 'none' && morph;
---

<a
  class:list={['btn', `btn--${variant}`, icon !== 'none' && `btn--${icon}`, morphs && 'btn--morph', className]}
  data-cal-button={cal ? '' : undefined}
  href={href}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener' : undefined}
>
  {icon === 'leading' && <ArrowIcon />}
  <span>{label}</span>
  {icon === 'trailing' && <ArrowIcon />}
  {
    morphs && (
      <span class="btn__morph" aria-hidden="true">
        <span class="btn__morph-icon">
          <ArrowIcon />
        </span>
      </span>
    )
  }
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--button-gap);
    height: var(--button-height);
    padding: var(--button-padding-y) var(--button-padding-x);
    border-radius: 100px;
    border: 1px solid transparent;
    font-family: var(--font-body);
    font-size: var(--button-font-size);
    font-weight: var(--font-weight-medium);
    font-style: normal;
    line-height: var(--button-line-height);
    letter-spacing: var(--button-tracking);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--motion-duration-fast) var(--motion-ease-out),
      color var(--motion-duration-fast) var(--motion-ease-out),
      border-color var(--motion-duration-fast) var(--motion-ease-out),
      box-shadow var(--motion-duration-fast) var(--motion-ease-out),
      padding var(--motion-duration-base) var(--motion-ease-enter);
  }

  .btn--trailing {
    padding: var(--button-padding-y) var(--button-padding-icon) var(--button-padding-y) var(--button-padding-end);
  }

  .btn--leading {
    padding: var(--button-padding-y) var(--button-padding-end) var(--button-padding-y) var(--button-padding-icon);
  }

  .btn--primary {
    background: var(--color-lime-300);
    color: var(--color-lime-950);
  }

  /* Figma Button, Type=Primary: Hover and Pressed carry a soft lime inner shadow from the top. */
  .btn--primary:hover {
    background: var(--color-lime-600);
    color: var(--color-lime-0);
    box-shadow: var(--shadow-button-primary-hover);
  }

  .btn--primary:active {
    background: var(--color-lime-800);
    color: var(--color-lime-0);
    box-shadow: var(--shadow-button-primary-pressed);
  }

  .btn--secondary {
    background: var(--color-lime-950);
    color: var(--color-neutral-0);
    border-color: var(--color-lime-0);
  }

  .btn--secondary:hover {
    background: var(--color-lime-0);
    color: var(--color-lime-900);
    border-color: rgba(13, 18, 2, 0.6);
  }

  .btn--secondary:active {
    background: var(--color-lime-50);
    color: var(--color-lime-900);
    border-color: rgba(13, 18, 2, 0.6);
  }

  .btn--block {
    width: 100%;
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-lime-300);
    outline-offset: 3px;
  }

  /* ===== Hover morph: No Icon → Trailing Icon =====
     The arrow's slot opens from 0 to the icon width (a 0fr → 1fr grid track) while the padding moves
     to the Trailing Icon values, so the pill grows smoothly into that variant. The arrow then pops
     out: it scales up past full size and tilts 8deg clockwise before settling back to 0deg. */
  .btn__morph {
    display: grid;
    grid-template-columns: 0fr;
    margin-left: calc(-1 * var(--button-gap));
    transition:
      grid-template-columns var(--motion-duration-base) var(--motion-ease-enter),
      margin-left var(--motion-duration-base) var(--motion-ease-enter);
  }

  .btn__morph-icon {
    min-width: 0;
    display: block;
    scale: 0;
    opacity: 0;
    transition:
      scale 200ms var(--motion-ease-fade),
      opacity 150ms var(--motion-ease-fade);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn--morph:hover {
      padding: var(--button-padding-y) var(--button-padding-icon) var(--button-padding-y) var(--button-padding-end);
    }

    .btn--morph:hover .btn__morph {
      grid-template-columns: 1fr;
      margin-left: 0;
    }

    .btn--morph:hover .btn__morph-icon {
      scale: 1;
      opacity: 1;
      transition:
        scale 460ms 60ms cubic-bezier(0.34, 1.56, 0.64, 1),
        opacity 160ms 60ms var(--motion-ease-fade);
      animation: btn-icon-tilt 520ms 60ms var(--motion-ease-in-out) both;
    }
  }

  @keyframes btn-icon-tilt {
    0% { rotate: 0deg; }
    45% { rotate: 8deg; }
    100% { rotate: 0deg; }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn__morph,
    .btn__morph-icon,
    .btn--morph:hover .btn__morph-icon {
      transition: none;
      animation: none;
    }
  }

  .btn :global(svg) {
    display: block;
    width: var(--button-icon);
    height: var(--button-icon);
    flex: 0 0 var(--button-icon);
  }
</style>
