---
import { withBase } from '../lib/url';

interface Props {
  kind: 'image' | 'video' | 'placeholder';
  frame: 'card' | 'hero' | 'slot';
  src?: string;
  webm?: string;
  poster?: string;
  alt?: string;
  label?: string;
}

const { kind, frame, src, webm, poster, alt = '', label = '' } = Astro.props;
const mediaSrc = src ? withBase(src) : undefined;
const mediaWebm = webm ? withBase(webm) : undefined;
const mediaPoster = poster ? withBase(poster) : undefined;
---

<div class:list={['study-media', `study-media--${frame}`, `study-media--${kind}`]} data-skeleton={kind === 'placeholder' ? undefined : ''}>
  {
    kind === 'placeholder' && (
      <p class="study-media__label text-meta">{label}</p>
    )
  }
  {
    kind === 'image' && mediaSrc && (
      <img src={mediaSrc} alt={alt} />
    )
  }
  {
    kind === 'video' && mediaSrc && (
      <>
        <img class="study-media__still" src={mediaPoster} alt={alt} />
        <video
          class="study-media__video"
          data-lazy-video
          muted
          loop
          playsinline
          preload="none"
          poster={mediaPoster}
          aria-label={alt || undefined}
        >
          {mediaWebm && <source src={mediaWebm} type="video/webm" />}
          <source src={mediaSrc} type="video/mp4" />
          {/* Clips with a transparent background ship as VP9-with-alpha WebM (Chrome, Firefox) and
              HEVC-with-alpha MP4 (Safari). Safari also plays the WebM but drops its alpha, so the
              script below removes the WebM source there. */}
        </video>
      </>
    )
  }
</div>

<script>
  /* Videos download only when they are about to scroll into view, play while visible and pause
     when they leave (and never play with reduced motion: the still shows instead). */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Safari (macOS and iOS, where every browser is WebKit) needs the HEVC MP4 for transparency.
  const webkit = /AppleWebKit/.test(navigator.userAgent) && !/Chrome|Chromium|Android/.test(navigator.userAgent);

  function bindVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]:not([data-bound])');
    if (!videos.length) return;
    if (webkit) videos.forEach((video) => video.querySelector('source[type="video/webm"]')?.remove());
    if (!('IntersectionObserver' in window)) {
      videos.forEach((video) => {
        video.preload = 'auto';
        if (!reduced.matches) video.play().catch(() => undefined);
      });
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && !reduced.matches) {
            video.preload = 'auto';
            video.play().catch(() => undefined);
          } else {
            video.pause();
          }
        }
      },
      { rootMargin: '200px 0px' },
    );
    videos.forEach((video) => {
      video.dataset.bound = '';
      observer.observe(video);
    });
  }

  bindVideos();
</script>

<style>
  .study-media {
    display: grid;
    place-items: center;
    width: 100%;
    background: var(--color-stone-100);
    overflow: hidden;
  }

  .study-media--card {
    position: absolute;
    inset: 0;
  }

  /* Figma inner page image blocks: Stone/100 with a 1px Stone/150 (60%) border. */
  .study-media--hero,
  .study-media--slot {
    min-height: 220px;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-stone-150);
    border-radius: var(--radius-sm);
  }

  .study-media--placeholder {
    background: var(--color-stone-100);
  }

  .study-media__label {
    margin: 0;
    padding: 24px;
    text-align: center;
    color: var(--color-stone-700);
  }

  .study-media img,
  .study-media video {
    display: block;
  }

  .study-media--card video,
  .study-media--card .study-media__still {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 100%;
    width: auto;
    max-width: 100%;
    max-height: 100%;
    transform: translate(-50%, -50%);
    object-fit: contain;
    object-position: center;
  }

  .study-media--hero video,
  .study-media--hero .study-media__still,
  .study-media--slot video,
  .study-media--slot .study-media__still,
  .study-media--hero img:not(.study-media__still),
  .study-media--slot img:not(.study-media__still) {
    width: min(100%, 420px);
    height: auto;
    object-fit: contain;
    object-position: center;
  }

  .study-media__still {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .study-media--video .study-media__video {
      display: none;
    }

    .study-media--video .study-media__still {
      display: block;
    }
  }
</style>
