---
import { withBase } from '../lib/url';

interface Props {
  kind: 'image' | 'video' | 'placeholder';
  frame: 'card' | 'hero' | 'slot';
  src?: string;
  webm?: string;
  poster?: string;
  alt?: string;
  label?: string;
  /** A screen recording, placed and cropped as in Figma 4192:24709. */
  screen?: boolean;
}

const { kind, frame, src, webm, poster, alt = '', label = '', screen = false } = Astro.props;
const mediaSrc = src ? withBase(src) : undefined;
const mediaWebm = webm ? withBase(webm) : undefined;
const mediaPoster = poster ? withBase(poster) : undefined;
---

<div class:list={['study-media', `study-media--${frame}`, `study-media--${kind}`, screen && 'study-media--screen']} data-skeleton={kind === 'placeholder' ? undefined : ''}>
  {
    kind === 'placeholder' && (
      <p class="study-media__label text-meta">{label}</p>
    )
  }
  {
    kind === 'image' && mediaSrc && (
      <img src={mediaSrc} alt={alt} />
    )
  }
  {
    kind === 'video' && mediaSrc && (
      <>
        <img class="study-media__still" src={mediaPoster} alt={alt} />
        <video
          class="study-media__video"
          data-lazy-video
          muted
          loop
          playsinline
          preload="none"
          poster={mediaPoster}
          aria-label={alt || undefined}
        >
          {mediaWebm && <source src={mediaWebm} type="video/webm" />}
          <source src={mediaSrc} type="video/mp4" />
          {/* Clips with a transparent background ship as VP9-with-alpha WebM (Chrome, Firefox) and
              HEVC-with-alpha MP4 (Safari). Safari also plays the WebM but drops its alpha, so the
              script below removes the WebM source there. */}
        </video>
      </>
    )
  }
</div>

<script>
  /* Videos download only when they are about to scroll into view, play while visible and pause
     when they leave (and never play with reduced motion: the still shows instead). */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Safari (macOS and iOS, where every browser is WebKit) needs the HEVC MP4 for transparency.
  const webkit = /AppleWebKit/.test(navigator.userAgent) && !/Chrome|Chromium|Android/.test(navigator.userAgent);

  function bindVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]:not([data-bound])');
    if (!videos.length) return;
    if (webkit) videos.forEach((video) => video.querySelector('source[type="video/webm"]')?.remove());
    if (!('IntersectionObserver' in window)) {
      videos.forEach((video) => {
        video.preload = 'auto';
        if (!reduced.matches) video.play().catch(() => undefined);
      });
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && !reduced.matches) {
            video.preload = 'auto';
            video.play().catch(() => undefined);
          } else {
            video.pause();
          }
        }
      },
      { rootMargin: '200px 0px' },
    );
    videos.forEach((video) => {
      video.dataset.bound = '';
      observer.observe(video);
    });
  }

  bindVideos();
</script>

<style>
  .study-media {
    display: grid;
    place-items: center;
    width: 100%;
    background: var(--color-stone-100);
    overflow: hidden;
  }

  .study-media--card {
    position: absolute;
    inset: 0;
  }

  /* Figma inner page image blocks: Stone/100 with a 1px Stone/150 (60%) border. */
  .study-media--hero,
  .study-media--slot {
    min-height: 220px;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-stone-150);
    border-radius: var(--radius-sm);
  }

  .study-media--placeholder {
    background: var(--color-stone-100);
  }

  .study-media__label {
    margin: 0;
    padding: 24px;
    text-align: center;
    color: var(--color-stone-700);
  }

  .study-media img,
  .study-media video {
    display: block;
  }

  .study-media--card video,
  .study-media--card .study-media__still {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 100%;
    width: auto;
    max-width: 100%;
    max-height: 100%;
    transform: translate(-50%, -50%);
    object-fit: contain;
    object-position: center;
  }

  .study-media--hero video,
  .study-media--hero .study-media__still,
  .study-media--slot video,
  .study-media--slot .study-media__still,
  .study-media--hero img:not(.study-media__still),
  .study-media--slot img:not(.study-media__still) {
    width: min(100%, 420px);
    height: auto;
    object-fit: contain;
    object-position: center;
  }

  /* Two classes, to outrank `.study-media img` above. */
  .study-media .study-media__still {
    display: none;
  }

  /* A screen recording (Leta), placed as in Figma 4192:24709: in the 1024 x 400 box the screen is
     774 wide, centred, 95 from the top and running off the bottom (cropped), radius 8, two soft
     shadows. Sized from the box height, so the card (also 400 tall on desktop) and the drawer hero
     show the same crop, on phones too; a narrower box trims the sides. */
  .study-media--screen {
    container-type: size;
  }

  .study-media--screen:not(.study-media--card) {
    position: relative;
  }

  .study-media.study-media--screen video,
  .study-media.study-media--screen .study-media__still {
    position: absolute;
    top: 23.75cqh; /* 95 / 400 */
    left: 50%;
    width: 193.5cqh; /* 774 / 400 */
    height: auto;
    max-width: none;
    max-height: none;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top center;
    transform: translateX(-50%);
    border-radius: 8px;
    box-shadow:
      0 0 12px rgba(10, 10, 10, 0.1),
      0 4px 4px rgba(250, 250, 250, 0.1);
    pointer-events: none;
  }

  /* Phones: sized from the width instead, keeping Figma's share of space at either side
     (125 / 1024 = 12.2%, so 774 / 1024 = 75.6% wide), and cropped at the bottom by the same share
     as in Figma (130 of the screen's 435 below the box): bottom = -(130 / 1024) of the box width. */
  @media (max-width: 767px) {
    .study-media.study-media--screen video,
    .study-media.study-media--screen .study-media__still {
      top: auto;
      bottom: -12.7cqw;
      width: 75.59cqw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .study-media--video .study-media__video {
      display: none;
    }

    .study-media--video .study-media__still {
      display: block;
    }
  }
</style>
