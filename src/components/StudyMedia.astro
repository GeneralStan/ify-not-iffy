---
import { withBase } from '../lib/url';
import LetaThemeCompare from './LetaThemeCompare';

interface Overlay {
  src: string;
  still: string;
  alt?: string;
  /** Left, top and width in percent of the image box; ratio is the animation's width / height. */
  x: number;
  y: number;
  w: number;
  ratio: number;
}

interface Props {
  kind: 'image' | 'video' | 'placeholder' | 'compare';
  frame: 'card' | 'hero' | 'slot';
  src?: string;
  webm?: string;
  poster?: string;
  alt?: string;
  label?: string;
  /** A screen recording, placed and cropped as in Figma 4192:24709. */
  screen?: boolean;
  /** A playground demo recording in a 16:10 box. */
  demo?: boolean;
  /** A looping animation laid over the image (the Overview's Login map). */
  overlay?: Overlay;
}

const { kind, frame, src, webm, poster, alt = '', label = '', screen = false, demo = false, overlay } = Astro.props;
const mediaSrc = src ? withBase(src) : undefined;
const mediaWebm = webm ? withBase(webm) : undefined;
const mediaPoster = poster ? withBase(poster) : undefined;
---

<div class:list={['study-media', `study-media--${frame}`, `study-media--${kind}`, screen && 'study-media--screen', demo && 'study-media--demo']} data-skeleton={kind === 'placeholder' ? undefined : ''}>
  {
    kind === 'placeholder' && (
      <p class="study-media__label text-meta">{label}</p>
    )
  }
  {
    kind === 'image' && mediaSrc && !overlay && (
      <img src={mediaSrc} alt={alt} />
    )
  }
  {
    kind === 'image' && mediaSrc && overlay && (
      <div class="study-media__stage">
        <img src={mediaSrc} alt={alt} />
        <picture
          class="study-media__overlay"
          style={`left: ${overlay.x}%; top: ${overlay.y}%; width: ${overlay.w}%; aspect-ratio: ${overlay.ratio};`}
        >
          <source srcset={withBase(overlay.still)} media="(prefers-reduced-motion: reduce)" />
          <img src={withBase(overlay.src)} alt={overlay.alt ?? ''} loading="lazy" decoding="async" />
        </picture>
      </div>
    )
  }
  {
    kind === 'compare' && <LetaThemeCompare client:visible />
  }
  {
    kind === 'video' && mediaSrc && (
      <>
        <img class="study-media__still" src={mediaPoster} alt={alt} />
        <video
          class="study-media__video"
          data-lazy-video
          muted
          loop
          playsinline
          preload="none"
          poster={mediaPoster}
          aria-label={alt || undefined}
        >
          {mediaWebm && <source src={mediaWebm} type="video/webm" />}
          <source src={mediaSrc} type="video/mp4" />
          {/* Clips with a transparent background ship as VP9-with-alpha WebM (Chrome, Firefox) and
              HEVC-with-alpha MP4 (Safari). Safari also plays the WebM but drops its alpha, so the
              script below removes the WebM source there. */}
        </video>
      </>
    )
  }
</div>

<script>
  /* Videos download only when they are about to scroll into view, play while visible and pause
     when they leave (and never play with reduced motion: the still shows instead). */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Safari (macOS and iOS, where every browser is WebKit) needs the HEVC MP4 for transparency.
  const webkit = /AppleWebKit/.test(navigator.userAgent) && !/Chrome|Chromium|Android/.test(navigator.userAgent);

  function bindVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]:not([data-bound])');
    if (!videos.length) return;
    if (webkit) videos.forEach((video) => video.querySelector('source[type="video/webm"]')?.remove());
    if (!('IntersectionObserver' in window)) {
      videos.forEach((video) => {
        video.preload = 'auto';
        if (!reduced.matches) video.play().catch(() => undefined);
      });
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && !reduced.matches) {
            video.preload = 'auto';
            video.play().catch(() => undefined);
          } else {
            video.pause();
          }
        }
      },
      { rootMargin: '200px 0px' },
    );
    videos.forEach((video) => {
      video.dataset.bound = '';
      observer.observe(video);
    });
  }

  bindVideos();
</script>

<style>
  .study-media {
    display: grid;
    place-items: center;
    width: 100%;
    background: var(--color-stone-100);
    overflow: hidden;
  }

  .study-media--card {
    position: absolute;
    inset: 0;
  }

  /* Figma inner page image blocks: Stone/100 with a 1px Stone/150 (60%) border. */
  .study-media--hero,
  .study-media--slot {
    min-height: 220px;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-stone-150);
    border-radius: var(--radius-sm);
  }

  .study-media--placeholder {
    background: var(--color-stone-100);
  }

  .study-media__label {
    margin: 0;
    padding: 24px;
    text-align: center;
    color: var(--color-stone-700);
  }

  .study-media img,
  .study-media video {
    display: block;
  }

  .study-media--card video,
  .study-media--card .study-media__still {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 100%;
    width: auto;
    max-width: 100%;
    max-height: 100%;
    transform: translate(-50%, -50%);
    object-fit: contain;
    object-position: center;
  }

  .study-media--hero video,
  .study-media--hero .study-media__still,
  .study-media--slot video,
  .study-media--slot .study-media__still,
  .study-media--hero img:not(.study-media__still),
  .study-media--slot img:not(.study-media__still) {
    width: min(100%, 420px);
    height: auto;
    object-fit: contain;
    object-position: center;
  }

  /* Two classes, to outrank `.study-media img` above. */
  .study-media .study-media__still {
    display: none;
  }

  /* A screen recording (Leta), placed as in Figma. The screenshot rectangle is 1.63 wide to 1 tall;
     the 16:9 clip fills it from the top (a sliver off each side). Radius 8, two soft shadows. */
  .study-media--screen {
    container-type: size;
  }

  .study-media--screen:not(.study-media--card) {
    position: relative;
  }

  .study-media.study-media--screen video,
  .study-media.study-media--screen .study-media__still {
    position: absolute;
    max-width: none;
    max-height: none;
    height: auto;
    object-fit: cover;
    object-position: top center;
    border-radius: 8px;
    box-shadow:
      0 0 12px rgba(10, 10, 10, 0.1),
      0 4px 4px rgba(250, 250, 250, 0.1);
    pointer-events: none;
  }

  /* Drawer hero (Figma 4192:24709): in the 1024 x 400 box the screen is 774 x 475, centred, 95 down,
     cropped at the bottom. Desktop: sized from the box height. */
  .study-media.study-media--screen:not(.study-media--card) video,
  .study-media.study-media--screen:not(.study-media--card) .study-media__still {
    top: 23.75cqh; /* 95 / 400 */
    left: 50%;
    width: 193.5cqh; /* 774 / 400 */
    aspect-ratio: 774 / 475;
    transform: translateX(-50%);
  }

  /* Work card (Figma Case Study Card on the live site, 4203:25206): in the 572 x 400 image box the
     screen is 523 x 321, 24 from each side, 94 down, cropped at the bottom. The box keeps its shape
     at every width, so phones show the same side gaps and crop. */
  .study-media.study-media--card.study-media--screen video,
  .study-media.study-media--card.study-media--screen .study-media__still {
    top: 23.5%; /* 94 / 400 */
    left: 4.28%; /* 24.5 / 572 */
    width: 91.43%; /* 523 / 572 */
    aspect-ratio: 523 / 321;
    transform: none;
  }

  /* An image with a looping animation laid over it: the stage keeps the Figma box's shape (1024 x 400)
     so the overlay's percentages line up at every width. */
  .study-media__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1024 / 400;
    overflow: hidden;
  }

  .study-media__stage > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .study-media__overlay {
    position: absolute;
    display: block;
  }

  .study-media__overlay img {
    width: 100%;
    height: 100%;
  }

  /* Light/dark compare (Figma 4257:35298): fills the 1024 x 400 box at every width. */
  .study-media--compare {
    display: block;
  }

  .study-media--compare :global(.leta-theme-compare) {
    width: 100%;
    height: 100%;
  }

  /* Playground demo recordings: a 16:10 box at every width, which the 1440 x 900 clip fills. */
  .study-media.study-media--demo {
    position: relative;
  }

  .study-media.study-media--demo video,
  .study-media.study-media--demo .study-media__still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: top center;
  }

  /* Phones, drawer hero: sized from the width instead, keeping Figma's share of space at either side
     (125 / 1024 = 12.2% each) and its bottom crop (170 of the 475 below the box, so -170 / 1024 of
     the box width). See docs/case-study-structure.md, "Screen images in a hero or card box". */
  @media (max-width: 767px) {
    .study-media.study-media--screen:not(.study-media--card) video,
    .study-media.study-media--screen:not(.study-media--card) .study-media__still {
      top: auto;
      bottom: -16.6cqw;
      width: 75.59cqw;
    }
  }
</style>
