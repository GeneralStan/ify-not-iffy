---
import { withBase } from '../lib/url';
import LetaThemeCompare from './LetaThemeCompare';
import BrowserFrame from './BrowserFrame.astro';

/** A screenshot in a browser frame, placed as in Figma: x, y and w in px of the Figma box. `vis`
    is the share of the screenshot's width inside the box (a screen that runs off the right edge). */
interface FrameShot {
  src: string;
  alt?: string;
  x: number;
  y: number;
  w: number;
  vis?: number;
}

interface Overlay {
  src: string;
  still: string;
  alt?: string;
  /** Left, top and width in percent of the image box; ratio is the animation's width / height. */
  x: number;
  y: number;
  w: number;
  ratio: number;
}

interface Props {
  kind: 'image' | 'video' | 'placeholder' | 'compare';
  frame: 'card' | 'hero' | 'slot';
  src?: string;
  webm?: string;
  poster?: string;
  alt?: string;
  label?: string;
  /** A screen recording, placed and cropped as in Figma 4192:24709. */
  screen?: boolean;
  /** A playground demo recording in a 16:10 box. */
  demo?: boolean;
  /** A looping animation laid over the image (the Overview's Login map). */
  overlay?: Overlay;
  /** Screenshots, each in a browser frame at its Figma position. */
  frames?: FrameShot[];
  /** The Figma box the frames are placed in, [width, height]. */
  box?: [number, number];
}

const { kind, frame, src, webm, poster, alt = '', label = '', screen = false, demo = false, overlay, frames, box } = Astro.props;

/* Where the browser window sits in each box (Figma px). Hero: Figma 4192:24709, 774 wide, centred,
   95 down. Work card: Case Study Card 4094:775, 523 wide, 24 from each side, 94 down. Demo: the whole
   window with 40 around it. Static screens: their own Figma rectangles (`frames`). */
const boxWidth = box?.[0] ?? (frame === 'card' ? 572 : 1024);
const videoSpot = demo ? { x: 40, y: 40, w: 944 } : frame === 'card' ? { x: 24.5, y: 94, w: 523 } : { x: 125, y: 95, w: 774 };
const place = (s: { x: number; y: number; w: number }) =>
  `left: ${((s.x / boxWidth) * 100).toFixed(3)}%; top: ${((s.y / boxWidth) * 100).toFixed(3)}cqw; width: ${((s.w / boxWidth) * 100).toFixed(3)}%;`;
const framedVideo = kind === 'video' && (screen || demo);
const framed = framedVideo || (kind === 'image' && !!frames?.length);
const mediaSrc = src ? withBase(src) : undefined;
const mediaWebm = webm ? withBase(webm) : undefined;
const mediaPoster = poster ? withBase(poster) : undefined;
---

<div class:list={['study-media', `study-media--${frame}`, `study-media--${kind}`, screen && 'study-media--screen', demo && 'study-media--demo', framed && 'study-media--framed']} data-skeleton={kind === 'placeholder' ? undefined : ''} data-media-reveal={kind === 'placeholder' ? undefined : ''}>
  {
    kind === 'placeholder' && (
      <p class="study-media__label text-meta">{label}</p>
    )
  }
  {
    kind === 'image' && frames?.length && (
      <div class="study-media__framebox">
        {frames.map((shot) => (
          <BrowserFrame style={place(shot)}>
            <img
              src={withBase(shot.src)}
              alt={shot.alt ?? alt}
              loading="lazy"
              decoding="async"
              style={shot.vis && shot.vis < 1 ? `width: ${(shot.vis * 100).toFixed(2)}%` : undefined}
            />
          </BrowserFrame>
        ))}
      </div>
    )
  }
  {
    kind === 'image' && mediaSrc && !overlay && !frames?.length && (
      <img src={mediaSrc} alt={alt} />
    )
  }
  {
    kind === 'image' && mediaSrc && overlay && (
      <div class="study-media__stage">
        <img src={mediaSrc} alt={alt} />
        <picture
          class="study-media__overlay"
          style={`left: ${overlay.x}%; top: ${overlay.y}%; width: ${overlay.w}%; aspect-ratio: ${overlay.ratio};`}
        >
          <source srcset={withBase(overlay.still)} media="(prefers-reduced-motion: reduce)" />
          <img src={withBase(overlay.src)} alt={overlay.alt ?? ''} loading="lazy" decoding="async" />
        </picture>
      </div>
    )
  }
  {
    kind === 'compare' && <LetaThemeCompare client:visible />
  }
  {
    framedVideo && mediaSrc && (
      <div class="study-media__framebox">
        <BrowserFrame style={place(videoSpot)}>
          <img class="study-media__still" src={mediaPoster} alt={alt} />
          <video
            class="study-media__video"
            data-lazy-video
            muted
            loop
            playsinline
            preload="none"
            poster={mediaPoster}
            aria-label={alt || undefined}
          >
            {mediaWebm && <source src={mediaWebm} type="video/webm" />}
            <source src={mediaSrc} type="video/mp4" />
          </video>
        </BrowserFrame>
      </div>
    )
  }
  {
    kind === 'video' && !framedVideo && mediaSrc && (
      <>
        <img class="study-media__still" src={mediaPoster} alt={alt} />
        <video
          class="study-media__video"
          data-lazy-video
          muted
          loop
          playsinline
          preload="none"
          poster={mediaPoster}
          aria-label={alt || undefined}
        >
          {mediaWebm && <source src={mediaWebm} type="video/webm" />}
          <source src={mediaSrc} type="video/mp4" />
          {/* Clips with a transparent background ship as VP9-with-alpha WebM (Chrome, Firefox) and
              HEVC-with-alpha MP4 (Safari). Safari also plays the WebM but drops its alpha, so the
              script below removes the WebM source there. */}
        </video>
      </>
    )
  }
</div>

<script>
  /* Videos download only when they are about to scroll into view, play while visible and pause
     when they leave (and never play with reduced motion: the still shows instead). */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Safari (macOS and iOS, where every browser is WebKit) needs the HEVC MP4 for transparency.
  const webkit = /AppleWebKit/.test(navigator.userAgent) && !/Chrome|Chromium|Android/.test(navigator.userAgent);

  function bindVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]:not([data-bound])');
    if (!videos.length) return;
    if (webkit) videos.forEach((video) => video.querySelector('source[type="video/webm"]')?.remove());
    if (!('IntersectionObserver' in window)) {
      videos.forEach((video) => {
        video.preload = 'auto';
        if (!reduced.matches) video.play().catch(() => undefined);
      });
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && !reduced.matches) {
            video.preload = 'auto';
            video.play().catch(() => undefined);
          } else {
            video.pause();
          }
        }
      },
      { rootMargin: '200px 0px' },
    );
    videos.forEach((video) => {
      video.dataset.bound = '';
      observer.observe(video);
    });
  }

  bindVideos();
</script>

<style>
  .study-media {
    display: grid;
    place-items: center;
    width: 100%;
    background: var(--color-stone-100);
    overflow: hidden;
  }

  .study-media--card {
    position: absolute;
    inset: 0;
  }

  /* Figma inner page image blocks: Stone/100 with a 1px Stone/150 (60%) border. */
  .study-media--hero,
  .study-media--slot {
    min-height: 220px;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-stone-150);
    border-radius: var(--radius-sm);
  }

  .study-media--placeholder {
    background: var(--color-stone-100);
  }

  .study-media__label {
    margin: 0;
    padding: 24px;
    text-align: center;
    color: var(--color-stone-700);
  }

  .study-media img,
  .study-media video {
    display: block;
  }

  .study-media--card video,
  .study-media--card .study-media__still {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 100%;
    width: auto;
    max-width: 100%;
    max-height: 100%;
    transform: translate(-50%, -50%);
    object-fit: contain;
    object-position: center;
  }

  .study-media--hero video,
  .study-media--hero .study-media__still,
  .study-media--slot video,
  .study-media--slot .study-media__still,
  .study-media--hero img:not(.study-media__still),
  .study-media--slot img:not(.study-media__still) {
    width: min(100%, 420px);
    height: auto;
    object-fit: contain;
    object-position: center;
  }

  /* Two classes, to outrank `.study-media img` above. */
  .study-media .study-media__still {
    display: none;
  }

  /* An image with a looping animation laid over it: the stage keeps the Figma box's shape (1024 x 400)
     so the overlay's percentages line up at every width. */
  .study-media__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1024 / 400;
    overflow: hidden;
  }

  .study-media__stage > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .study-media__overlay {
    position: absolute;
    display: block;
  }

  .study-media__overlay img {
    width: 100%;
    height: 100%;
  }

  /* Light/dark compare (Figma 4257:35298): fills the 1024 x 400 box at every width. */
  .study-media--compare {
    display: block;
  }

  .study-media--compare :global(.leta-theme-compare) {
    width: 100%;
    height: 100%;
  }

  /* Browser-framed screens: the box is the container, so the frames' cqw offsets and the windows
     themselves scale together with the box at every width. The box crops each window's bottom. */
  .study-media--framed {
    position: relative;
    container-type: inline-size;
  }

  .study-media__framebox {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .study-media.study-media--framed .study-media__framebox :global(img),
  .study-media.study-media--framed .study-media__framebox :global(video) {
    width: 100%;
    height: auto;
    position: static;
    max-width: none;
    max-height: none;
    transform: none;
    object-fit: fill;
  }

  .study-media--framed .study-media__framebox :global(.study-media__still) {
    display: none;
  }

</style>
