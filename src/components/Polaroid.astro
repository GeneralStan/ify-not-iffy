---
/**
 * Polaroid (Figma "Components" 4031:3204, frames Polaroid-*).
 * The exported PNGs are 931x1047 (4x) with a soft shadow baked in; the card itself fills
 * x 21.7–78.3%, y 18.4–79.9% of the image. The shine is clipped to that card.
 * Size it with font-size or the --pol-w / --pol-h custom properties on the parent.
 * Interactions (hover 1.1x, tap pop 1.2x + shimmer) live in src/scripts/polaroid.ts.
 */
import { Picture } from 'astro:assets';
import atSea from '../assets/polaroids/polaroid-at-sea.png';
import atDinner from '../assets/polaroids/polaroid-at-dinner.png';
import catMaisha from '../assets/polaroids/polaroid-cat-maisha.png';
import catMooncake from '../assets/polaroids/polaroid-cat-mooncake.png';
import tennisBackhand from '../assets/polaroids/polaroid-tennis-backhand.png';
import tennisForehand from '../assets/polaroids/polaroid-tennis-forehand.png';
import raceTrophy from '../assets/polaroids/polaroid-race-trophy.png';
import userResearch from '../assets/polaroids/polaroid-user-research.png';

const photos = {
  'at-sea': atSea,
  'at-dinner': atDinner,
  'cat-maisha': catMaisha,
  'cat-mooncake': catMooncake,
  'tennis-backhand': tennisBackhand,
  'tennis-forehand': tennisForehand,
  'race-trophy': raceTrophy,
  'user-research': userResearch,
} as const;


interface Props {
  photo: keyof typeof photos;
  /** Rendered width of the whole PNG box in CSS px, used for the srcset `sizes` hint
      (raised 20% so the tap pop to 1.2x stays sharp). */
  displayWidth?: number;
  /** A full `sizes` value, for polaroids whose size changes with the screen (About strip). */
  sizes?: string;
  class?: string;
  eager?: boolean;
  /** Grow in (0 → 120% → 100%) the first time it scrolls into view, after this many ms. */
  revealDelay?: number;
  style?: string;
}

const { photo, displayWidth = 96, sizes, class: className, eager = false, revealDelay, style } = Astro.props;
const revealStyle = revealDelay !== undefined ? `--reveal-delay: ${revealDelay}ms;` : '';
---

<span
  class:list={['polaroid', className]}
  data-polaroid
  data-reveal={revealDelay !== undefined ? 'pop' : undefined}
  style={`${revealStyle}${style ?? ''}` || undefined}
  aria-hidden="true"
>
  <span class="polaroid__card">
    <Picture
      class="polaroid__img"
      src={photos[photo]}
      formats={['avif', 'webp']}
      widths={[192, 256, 384, 512, 768, 931]}
      sizes={sizes ?? `${Math.round(displayWidth * 1.2)}px`}
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
    <span class="polaroid__shine"></span>
  </span>
</span>

<script>
  import '../scripts/polaroid';
</script>

<style is:global>
  /* ===== Polaroid ===== */
  .polaroid {
    position: absolute;
    z-index: 2;
    left: 0;
    top: 0;
    width: var(--pol-w, 1.518em);
    height: var(--pol-h, 1.714em);
    rotate: var(--pol-rotate, 0deg);
    /* Only the card (not the PNG's transparent margin) reacts to the pointer; see .polaroid__shine. */
    pointer-events: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    /* No selection box or image callout when the photo is tapped or held on phones. */
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  .polaroid img {
    -webkit-user-drag: none;
  }

  .polaroid:hover,
  .polaroid.is-popping {
    z-index: 5;
  }

  .polaroid__card {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transition: scale var(--motion-duration-slow) var(--motion-ease-enter);
  }

  @media (hover: hover) and (pointer: fine) {
    .polaroid:hover .polaroid__card {
      scale: 1.1;
    }
  }

  .polaroid__img,
  .polaroid picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .polaroid__img {
    object-fit: contain;
  }

  .polaroid__shine {
    position: absolute;
    inset: 18.4% 21.7% 20.1% 21.7%;
    overflow: hidden;
    border-radius: 3%;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }

  .polaroid__shine::before {
    content: '';
    position: absolute;
    inset: -10% 0;
    background: linear-gradient(
      100deg,
      transparent 30%,
      rgba(255, 255, 255, 0.15) 42%,
      rgba(255, 255, 255, 0.75) 50%,
      rgba(255, 255, 255, 0.15) 58%,
      transparent 70%
    );
    mix-blend-mode: screen;
    opacity: 0;
    transform: translateX(-130%) skewX(-18deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .polaroid__card {
      transition: none;
    }

    .polaroid:hover .polaroid__card {
      scale: 1;
    }
  }
</style>
