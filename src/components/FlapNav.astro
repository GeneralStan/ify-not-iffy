---
import { assetSrc } from '../lib/url';
import workHero from '../assets/home/nav-flap-work-hero.svg';
import workDocked from '../assets/home/nav-flap-work-docked.svg';
import playHero from '../assets/home/nav-flap-playground-hero.svg';
import playDocked from '../assets/home/nav-flap-playground-docked.svg';
import aboutHero from '../assets/home/nav-flap-about-hero.svg';
import aboutDocked from '../assets/home/nav-flap-about-docked.svg';

interface Props {
  current?: 'work' | 'playground' | 'about';
}

const { current = 'work' } = Astro.props;

const items = [
  { id: 'work', href: '#work', label: 'Work', hero: workHero, docked: workDocked },
  { id: 'playground', href: '#playground', label: 'Playground', hero: playHero, docked: playDocked },
  { id: 'about', href: '#about', label: 'About', hero: aboutHero, docked: aboutDocked },
] as const;
---

<nav class="flap-nav" data-flap-nav aria-label="Primary">
  <ul class="flap-nav__list">
    {
      items.map((item) => (
        <li class={`flap-nav__item flap-nav__item--${item.id}`}>
          <a
            class="flap-nav__link"
            href={item.href}
            data-section={item.id}
            aria-current={current === item.id ? 'page' : undefined}
          >
            <span class="flap-nav__flap" aria-hidden="true">
              <img class="flap-nav__shape flap-nav__shape--hero" src={assetSrc(item.hero)} alt="" />
              <img class="flap-nav__shape flap-nav__shape--docked" src={assetSrc(item.docked)} alt="" />
            </span>
            <span class="flap-nav__label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const nav = document.querySelector('[data-flap-nav]');
  const sentinel = document.querySelector('[data-flap-sentinel]');
  if (nav instanceof HTMLElement && sentinel instanceof Element) {
    let ready = false;
    const apply = (docked: boolean) => {
      const next = docked ? 'true' : 'false';
      const prev = nav.dataset.docked;
      nav.dataset.docked = next;
      if (ready && prev !== next) {
        nav.dataset.motion = docked ? 'dock' : 'undock';
      }
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        apply(entry.boundingClientRect.bottom <= 0);
        ready = true;
      },
      { threshold: 0 },
    );

    observer.observe(sentinel);
  }
</script>

<style>
  .flap-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    width: 100%;
    pointer-events: none;
    container-type: scroll-state;
  }

  .flap-nav__list {
    pointer-events: auto;
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    width: 720px;
    max-width: 100%;
    height: 80px;
    margin: 0;
    padding: 0;
    list-style: none;
    transform: translateY(0);
    transform-origin: top center;
  }

  .flap-nav[data-motion='dock'] .flap-nav__list {
    animation: flap-dock var(--motion-duration-flap) var(--motion-easing-spring) both;
  }

  .flap-nav[data-motion='undock'] .flap-nav__list {
    animation: flap-undock var(--motion-duration-flap) var(--motion-easing-spring) both;
  }

  @keyframes flap-dock {
    from {
      transform: translateY(-20px);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes flap-undock {
    from {
      transform: translateY(20px);
    }
    to {
      transform: translateY(0);
    }
  }

  .flap-nav__item {
    flex: 0 0 240px;
    width: 240px;
    height: 66px;
  }

  .flap-nav__item--work {
    height: 80px;
  }

  .flap-nav__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .flap-nav__label {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: var(--font-weight-regular);
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -0.8px;
  }

  .flap-nav__item--work .flap-nav__label {
    padding-top: 8px;
  }

  .flap-nav__link[aria-current='page'] .flap-nav__label {
    font-weight: var(--font-weight-medium);
  }

  .flap-nav__item--work .flap-nav__label {
    color: var(--color-lime-900);
  }

  .flap-nav__item--playground .flap-nav__label {
    color: var(--color-plum-900);
  }

  .flap-nav__item--about .flap-nav__label {
    color: var(--color-blue-900);
  }

  .flap-nav__flap {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .flap-nav__shape {
    display: block;
    width: 100%;
    height: 100%;
  }

  .flap-nav__shape--docked {
    display: none;
  }

  .flap-nav[data-docked='true'] {
    margin-top: 0;
  }

  .flap-nav[data-docked='true'] .flap-nav__list {
    align-items: flex-start;
    height: 72px;
  }

  .flap-nav[data-docked='true'] .flap-nav__item,
  .flap-nav[data-docked='true'] .flap-nav__item--work {
    height: 66px;
  }

  .flap-nav[data-docked='true'] .flap-nav__item--work .flap-nav__label {
    padding-top: 0;
  }

  .flap-nav[data-docked='true'] .flap-nav__shape--hero {
    display: none;
  }

  .flap-nav[data-docked='true'] .flap-nav__shape--docked {
    display: block;
  }

  .flap-nav__link:focus-visible {
    outline: 2px solid var(--color-lime-300);
    outline-offset: 3px;
  }

  @supports (container-type: scroll-state) {
    @container scroll-state(stuck: top) {
      .flap-nav__list {
        align-items: flex-start;
        height: 72px;
        animation: flap-dock var(--motion-duration-flap) var(--motion-easing-spring) both;
      }

      .flap-nav__item,
      .flap-nav__item--work {
        height: 66px;
      }

      .flap-nav__item--work .flap-nav__label {
        padding-top: 0;
      }

      .flap-nav__shape--hero {
        display: none;
      }

      .flap-nav__shape--docked {
        display: block;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flap-nav[data-motion='dock'] .flap-nav__list,
    .flap-nav[data-motion='undock'] .flap-nav__list {
      animation: none;
    }

    @supports (container-type: scroll-state) {
      @container scroll-state(stuck: top) {
        .flap-nav__list {
          animation: none;
        }
      }
    }
  }

  @media (max-width: 767px) {
    .flap-nav {
      top: env(safe-area-inset-top, 0px);
      padding-inline: 16px;
      box-sizing: border-box;
    }

    .flap-nav__list {
      width: 100%;
      height: 56px;
    }

    .flap-nav__item,
    .flap-nav__item--work {
      flex: 1 1 0;
      width: auto;
      height: 48px;
    }

    .flap-nav__label {
      font-size: 18px;
      line-height: 24px;
      letter-spacing: -0.6px;
    }

    .flap-nav__item--work .flap-nav__label {
      padding-top: 4px;
    }

    .flap-nav[data-docked='true'] {
      margin-top: 0;
    }

    .flap-nav[data-docked='true'] .flap-nav__list {
      height: 56px;
    }

    .flap-nav[data-docked='true'] .flap-nav__item,
    .flap-nav[data-docked='true'] .flap-nav__item--work {
      height: 48px;
    }
  }
</style>
