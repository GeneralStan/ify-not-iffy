---
import { assetSrc, withBase } from '../lib/url';
import workHero from '../assets/home/nav-flap-work-hero.svg';
import workDocked from '../assets/home/nav-flap-work-docked.svg';
import playHero from '../assets/home/nav-flap-playground-hero.svg';
import playDocked from '../assets/home/nav-flap-playground-docked.svg';
import aboutHero from '../assets/home/nav-flap-about-hero.svg';
import aboutDocked from '../assets/home/nav-flap-about-docked.svg';

interface Props {
  current?: 'work' | 'playground' | 'about';
  /** Hero pages dock on scroll. Other pages start in the docked shape. */
  mode?: 'hero' | 'docked';
}

const { current = 'work', mode = 'hero' } = Astro.props;

const plates = {
  work: 'var(--color-stone-0)',
  playground: 'var(--color-plum-200)',
  about: 'var(--color-blue-300)',
} as const;

const items = [
  { id: 'work', href: withBase('/'), label: 'Work', hero: workHero, docked: workDocked },
  { id: 'playground', href: withBase('/playground/'), label: 'Playground', hero: playHero, docked: playDocked },
  { id: 'about', href: withBase('/about/'), label: 'About', hero: aboutHero, docked: aboutDocked },
] as const;
---

<div class="flap-slot" data-flap-slot data-flap-mode={mode}>
  <nav
    class="flap-nav"
    data-flap-nav
    data-docked={mode === 'docked' ? 'true' : 'false'}
    style={`--flap-plate: ${plates[current]}`}
    aria-label="Primary"
  >
    <div class="flap-nav__plate" aria-hidden="true"></div>
    <ul class="flap-nav__list">
      {
        items.map((item) => (
          <li class={`flap-nav__item flap-nav__item--${item.id}`}>
            <a
              class="flap-nav__link"
              href={item.href}
              aria-current={current === item.id ? 'page' : undefined}
            >
              <span class="flap-nav__flap" aria-hidden="true">
                <img class="flap-nav__shape flap-nav__shape--hero" src={assetSrc(item.hero)} alt="" />
                <img class="flap-nav__shape flap-nav__shape--docked" src={assetSrc(item.docked)} alt="" />
              </span>
              <span class="flap-nav__label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  const slot = document.querySelector('[data-flap-slot]');
  const nav = document.querySelector('[data-flap-nav]');

  if (slot instanceof HTMLElement && nav instanceof HTMLElement && slot.dataset.flapMode === 'hero') {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let docked = slot.getBoundingClientRect().top <= 0;
    nav.dataset.docked = docked ? 'true' : 'false';

    const apply = (next: boolean) => {
      if (next === docked) return;
      docked = next;
      nav.dataset.docked = docked ? 'true' : 'false';
      nav.removeAttribute('data-motion');
      if (docked && !reduced.matches) {
        void nav.offsetWidth;
        nav.dataset.motion = 'dock';
      }
    };

    let frame = 0;
    const read = () => {
      frame = 0;
      const top = slot.getBoundingClientRect().top;
      // 12px of hysteresis so iOS rubber-banding does not flicker the shape.
      apply(docked ? top <= 12 : top <= 0);
    };

    const onScroll = () => {
      if (frame) return;
      frame = requestAnimationFrame(read);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.visualViewport?.addEventListener('resize', onScroll);
    window.visualViewport?.addEventListener('scroll', onScroll);
    read();
  }
</script>

<style>
  .flap-slot {
    position: relative;
    z-index: 50;
    width: 100%;
    height: 0;
  }

  .flap-nav {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: calc(80 / 720 * min(720px, 100vw));
    container-type: inline-size;
    pointer-events: none;
    background: transparent;
  }

  .flap-nav__plate {
    display: none;
  }

  .flap-nav__list {
    position: relative;
    z-index: 1;
    pointer-events: auto;
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    width: min(720px, 100%);
    height: 100%;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .flap-nav[data-motion='dock'] .flap-nav__list {
    animation: flap-settle var(--motion-duration-flap) var(--motion-ease-out) both;
  }

  @keyframes flap-settle {
    from {
      transform: translateY(-10px);
    }
    to {
      transform: translateY(0);
    }
  }

  .flap-nav__item {
    flex: 1 1 0;
    height: calc(66 / 80 * 100%);
    min-width: 0;
  }

  .flap-nav__item--work {
    height: 100%;
  }

  .flap-nav__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .flap-nav__label {
    position: relative;
    z-index: 1;
    font-family: var(--type-nav-family);
    font-weight: var(--type-nav-weight);
    font-size: var(--type-nav-size);
    line-height: var(--type-nav-line-height);
    letter-spacing: var(--type-nav-tracking);
  }

  .flap-nav__item--work .flap-nav__label {
    font-weight: var(--font-weight-medium);
    color: var(--color-lime-900);
  }

  .flap-nav__item--playground .flap-nav__label {
    color: var(--color-plum-900);
  }

  .flap-nav__item--about .flap-nav__label {
    color: var(--color-blue-900);
  }

  .flap-nav__flap {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .flap-nav__shape {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: fill;
  }

  .flap-nav__shape--docked {
    opacity: 0;
  }

  .flap-nav[data-docked='true'] {
    position: fixed;
    top: 0;
    bottom: auto;
    justify-content: flex-start;
    height: auto;
    pointer-events: auto;
    background: var(--flap-plate, var(--color-stone-0));
  }

  .flap-nav[data-docked='true'] .flap-nav__plate {
    display: block;
    flex: none;
    height: env(safe-area-inset-top, 0px);
    background: var(--flap-plate, var(--color-stone-0));
  }

  .flap-nav[data-docked='true'] .flap-nav__list {
    align-items: flex-start;
    height: calc(66 / 720 * min(720px, 100cqw, 100vw));
    flex: none;
  }

  .flap-nav[data-docked='true']::after {
    content: '';
    display: block;
    flex: none;
    height: calc(6 / 720 * min(720px, 100cqw, 100vw));
    background: var(--flap-plate, var(--color-stone-0));
  }

  .flap-nav[data-docked='true'] .flap-nav__item,
  .flap-nav[data-docked='true'] .flap-nav__item--work {
    height: 100%;
  }

  .flap-nav[data-docked='true'] .flap-nav__shape--hero {
    opacity: 0;
  }

  .flap-nav[data-docked='true'] .flap-nav__shape--docked {
    opacity: 1;
  }

  .flap-nav__link:focus-visible {
    outline: 2px solid var(--color-lime-300);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .flap-nav[data-motion='dock'] .flap-nav__list {
      animation: none;
    }
  }
</style>
