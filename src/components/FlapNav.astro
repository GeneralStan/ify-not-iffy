---
import { assetSrc, withBase } from '../lib/url';
import workHero from '../assets/home/nav-flap-work-hero.svg';
import workDocked from '../assets/home/nav-flap-work-docked.svg';
import playHero from '../assets/home/nav-flap-playground-hero.svg';
import playDocked from '../assets/home/nav-flap-playground-docked.svg';
import aboutHero from '../assets/home/nav-flap-about-hero.svg';
import aboutDocked from '../assets/home/nav-flap-about-docked.svg';

interface Props {
  current?: 'work' | 'playground' | 'about';
  /** Hero pages dock on scroll. Other pages start in the docked shape. */
  mode?: 'hero' | 'docked';
}

const { current = 'work', mode = 'hero' } = Astro.props;

const plates = {
  work: 'var(--color-stone-0)',
  playground: 'var(--color-plum-200)',
  about: 'var(--color-blue-300)',
} as const;

const items = [
  { id: 'work', href: withBase('/'), label: 'Work', hero: workHero, docked: workDocked },
  { id: 'playground', href: withBase('/playground/'), label: 'Playground', hero: playHero, docked: playDocked },
  { id: 'about', href: withBase('/about/'), label: 'About', hero: aboutHero, docked: aboutDocked },
] as const;
---

<div class="flap-slot" data-flap-slot data-flap-mode={mode}>
  <nav
    class="flap-nav"
    data-flap-nav
    data-docked={mode === 'docked' ? 'true' : 'false'}
    style={`--flap-plate: ${plates[current]}`}
    aria-label="Primary"
  >
    <div class="flap-nav__plate" aria-hidden="true"></div>
    <ul class="flap-nav__list">
      {
        items.map((item) => (
          <li class={`flap-nav__item flap-nav__item--${item.id}`}>
            <a
              class="flap-nav__link"
              href={item.href}
              aria-current={current === item.id ? 'page' : undefined}
            >
              <span class="flap-nav__flap" aria-hidden="true">
                <img class="flap-nav__shape flap-nav__shape--hero" src={assetSrc(item.hero)} alt="" />
                <img class="flap-nav__shape flap-nav__shape--docked" src={assetSrc(item.docked)} alt="" />
              </span>
              <span class="flap-nav__label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  // Docking: the slot is `position: sticky`, so the flaps never leave the screen.
  // A sentinel at the bottom of the hero says when the flaps have reached the top;
  // then only the shapes and the plate change (opacity + transform, no layout jump).
  const slot = document.querySelector<HTMLElement>('[data-flap-slot]');
  const nav = document.querySelector<HTMLElement>('[data-flap-nav]');
  const sentinel = document.querySelector<HTMLElement>('[data-flap-sentinel]');

  if (slot && nav && sentinel && slot.dataset.flapMode === 'hero') {
    let observer: IntersectionObserver | null = null;

    const setDocked = (docked: boolean) => {
      const next = docked ? 'true' : 'false';
      if (nav.dataset.docked !== next) nav.dataset.docked = next;
    };

    const watch = () => {
      observer?.disconnect();
      // The sentinel sits at the hero's bottom edge. It is "visible" while it is below the
      // flaps' height from the top of the viewport; above that, the flaps are stuck.
      const top = Math.round(nav.getBoundingClientRect().height);
      observer = new IntersectionObserver(
        ([entry]) => {
          const above = entry.boundingClientRect.top < (entry.rootBounds?.top ?? top);
          setDocked(!entry.isIntersecting && above);
        },
        { rootMargin: `-${top}px 0px 0px 0px`, threshold: 0 },
      );
      observer.observe(sentinel);
    };

    watch();
    let resizeFrame = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(watch);
    });
  }
</script>

<style>
  /* Height 0 and sticky: the nav hangs above the slot's top edge, so before docking it overlaps the
     hero's bottom (Figma 4026:607, y 720 of 800) and once stuck it fills the top of the viewport. */
  .flap-slot {
    position: sticky;
    top: calc(var(--flap-h) + env(safe-area-inset-top, 0px));
    z-index: 50;
    width: 100%;
    height: 0;
  }

  .flap-nav {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(var(--flap-h) + env(safe-area-inset-top, 0px));
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none;
  }

  /* Full-width plate behind the docked flaps (Figma 4026:1010). It fades, never pops. */
  .flap-nav__plate {
    position: absolute;
    inset: 0 0 calc(var(--flap-h) - 72 / 720 * var(--flap-w)) 0;
    background: var(--flap-plate, var(--color-stone-0));
    opacity: 0;
    transition: opacity var(--motion-duration-base) var(--motion-ease-fade);
  }

  .flap-nav__list {
    position: relative;
    z-index: 1;
    pointer-events: auto;
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    width: var(--flap-w);
    height: var(--flap-h);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .flap-nav__item {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
  }

  .flap-nav__link {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
  }

  /* Hero: Work is 80 tall, the others 66 and sit on the bottom edge (y 14).
     Docked: all three are 66 tall and hang from the top. The label moves with its flap. */
  .flap-nav__label {
    position: relative;
    z-index: 1;
    font-family: var(--type-nav-family);
    font-weight: var(--type-nav-weight);
    font-size: var(--type-nav-size);
    line-height: var(--type-nav-line-height);
    letter-spacing: var(--type-nav-tracking);
    transform: translateY(calc(7 / 80 * var(--flap-h)));
    transition: transform var(--motion-duration-slow) var(--motion-ease-enter);
  }

  .flap-nav__item--work .flap-nav__label {
    font-weight: var(--font-weight-medium);
    color: var(--color-lime-900);
    transform: none;
  }

  .flap-nav__item--playground .flap-nav__label {
    color: var(--color-plum-900);
  }

  .flap-nav__item--about .flap-nav__label {
    color: var(--color-blue-900);
  }

  .flap-nav__flap {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .flap-nav__shape {
    position: absolute;
    left: 0;
    width: 100%;
    display: block;
    object-fit: fill;
    transition:
      opacity var(--motion-duration-base) var(--motion-ease-fade),
      transform var(--motion-duration-slow) var(--motion-ease-enter);
  }

  .flap-nav__shape--hero {
    bottom: 0;
    height: calc(66 / 80 * 100%);
  }

  .flap-nav__item--work .flap-nav__shape--hero {
    height: 100%;
  }

  .flap-nav__shape--docked {
    top: 0;
    height: calc(66 / 80 * 100%);
    opacity: 0;
    transform: translateY(calc(14 / 80 * var(--flap-h)));
  }

  .flap-nav[data-docked='true'] {
    pointer-events: auto;
  }

  .flap-nav[data-docked='true'] .flap-nav__plate {
    opacity: 1;
  }

  .flap-nav[data-docked='true'] .flap-nav__shape--hero {
    opacity: 0;
    transform: translateY(calc(-14 / 80 * var(--flap-h)));
  }

  .flap-nav[data-docked='true'] .flap-nav__shape--docked {
    opacity: 1;
    transform: none;
  }

  .flap-nav[data-docked='true'] .flap-nav__label {
    transform: translateY(calc(-7 / 80 * var(--flap-h)));
  }

  .flap-nav__link:focus-visible {
    outline: 2px solid var(--color-lime-300);
    outline-offset: -4px;
  }

  .flap-nav__link:hover .flap-nav__label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .flap-nav__shape,
    .flap-nav__label {
      transition-property: opacity;
    }
  }
</style>
