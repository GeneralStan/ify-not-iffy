---
/**
 * Flap navigation, built from the Figma component set "Flaps" (4031:2832),
 * "Hero Navigation" (4029:2506) and "Docked Navigation" (4031:3203).
 *
 * Geometry (desktop, 1 unit = 1px):
 *  - Each flap is 240 wide. Idle is 66 tall, Hover / Pressed are 80, Active is 80 in the hero and 66 docked.
 *  - Hero flaps stand on the hero's bottom edge, chamfer top-left, and grow upward.
 *  - Docked flaps are the same shape flipped vertically (Figma: matrix(1,0,0,-1)), hang from the
 *    top of the viewport, chamfer bottom-left, and grow downward.
 *  - The label is centred in the 66 shape and moves 7 away from the edge when the flap is 80 tall.
 *  - Docked bar: 1240 wide, logo 48px on the left, flaps right-aligned, no background plate.
 *
 * Motion: the hero → docked change is a real hinge. Each flap is a two-sided card that rotates 180°
 * around the edge it stands on, so the hero face (above the line) turns into the docked face (below
 * the line), one flap after another. See .claude/skills/site-motion/SKILL.md.
 */
import { withBase } from '../lib/url';
import IffyLogo from '../assets/home/iffy-logo.svg';
import type { PageId } from '../data/site';

interface Props {
  current?: PageId;
}

const { current = 'work' } = Astro.props;

// Figma flap backgrounds (Flaps 4031:2832): chamfer top-left, 8px rounded corners at both ends of the
// chamfer and at the top right. Desktop flaps are 200x56 (64 when hovered, pressed or current);
// Mobile flaps are 119x44 (56). Work's chamfer is shallower than Playground's and About's. Paths are
// generated from Figma's vertex positions and radii with Figma's own corner curves.
const shapes = {
  work: {
    desktop: 'M0 18.6807C0 16.4704 0.9145 14.3586 2.5264 12.8463L13.911 2.1656C15.394 0.7744 17.3512 0 19.3846 0H192C196.4183 0 200 3.5817 200 8V56H0Z',
    mobile: 'M0 14.7817C0 12.9531 0.6264 11.1798 1.7749 9.7569L7.249 2.9752C8.7677 1.0937 11.056 0 13.474 0H111C115.4183 0 119 3.5817 119 8V44H0Z',
  },
  tall: {
    desktop: 'M0 21.5105C0 19.5701 0.7053 17.6957 1.9845 16.2366L13.8294 2.7261C15.3484 0.9935 17.5407 0 19.8449 0H192C196.4183 0 200 3.5817 200 8V56H0Z',
    mobile: 'M0 16.9498C0 15.3756 0.4644 13.8364 1.3351 12.5249L7.2769 3.5751C8.7594 1.3422 11.2616 0 13.9418 0H111C115.4183 0 119 3.5817 119 8V44H0Z',
  },
};

const items = [
  { id: 'work', href: withBase('/'), label: 'Work', shape: shapes.work },
  { id: 'playground', href: withBase('/playground/'), label: 'Playground', shape: shapes.tall },
  { id: 'about', href: withBase('/about/'), label: 'About', shape: shapes.tall },
] as const;
---

<div class="flap-slot" data-flap-slot data-docked="false" data-stuck="false" transition:persist="flaps">
  <div class="flap-edge" aria-hidden="true">
    <span class="flap-edge__blur flap-edge__blur--1"></span>
    <span class="flap-edge__blur flap-edge__blur--2"></span>
    <span class="flap-edge__blur flap-edge__blur--3"></span>
  </div>
  <nav class="flap-nav" aria-label="Primary">
    <a class="flap-logo" href={withBase('/')} data-flap-logo data-home data-page-link="work" aria-label="Ifeanyi Ulasika, Work" tabindex="-1">
      <span class="flap-logo__spin" data-spin>
        <IffyLogo class="flap-logo__mark" width="48" height="48" />
      </span>
    </a>
    <ul class="flap-list">
      {
        items.map((item, index) => (
          <li class={`flap flap--${item.id}`} style={`--i: ${index}`}>
            <a
              class="flap__card"
              href={item.href}
              data-flap-link
              data-page-link={item.id}
              aria-current={current === item.id ? 'page' : undefined}
            >
              <span class="flap__sr">{item.label}</span>
              <span class="flap__face flap__face--hero" aria-hidden="true">
                <svg class="flap__shape flap__shape--desktop" viewBox="0 0 200 56" preserveAspectRatio="none" focusable="false">
                  <path d={item.shape.desktop} />
                </svg>
                <svg class="flap__shape flap__shape--mobile" viewBox="0 0 119 44" preserveAspectRatio="none" focusable="false">
                  <path d={item.shape.mobile} />
                </svg>
                <span class="flap__label">{item.label}</span>
              </span>
              <span class="flap__face flap__face--docked" aria-hidden="true">
                <svg class="flap__shape flap__shape--desktop" viewBox="0 0 200 56" preserveAspectRatio="none" focusable="false">
                  <path d={item.shape.desktop} transform="matrix(1 0 0 -1 0 56)" />
                </svg>
                <svg class="flap__shape flap__shape--mobile" viewBox="0 0 119 44" preserveAspectRatio="none" focusable="false">
                  <path d={item.shape.mobile} transform="matrix(1 0 0 -1 0 44)" />
                </svg>
                <span class="flap__label">{item.label}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  import { navigate } from 'astro:transitions/client';

  const slot = document.querySelector<HTMLElement>('[data-flap-slot]');
  const logo = slot?.querySelector<HTMLElement>('[data-flap-logo]') ?? null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* ---------- Dock on scroll ----------
     The slot is a zero-height sticky line right under the hero. The flaps only hinge into the docked
     shape once that line has reached the top of the screen, i.e. the hero is completely gone; they
     hinge back as soon as it comes down again (24px of hysteresis stops flicker). */
  if (slot) {
    let frame = 0;

    const update = () => {
      frame = 0;
      const line = slot.getBoundingClientRect().top;
      const docked = slot.dataset.docked === 'true';
      if (!docked && line <= 0.5) {
        slot.dataset.docked = 'true';
        logo?.removeAttribute('tabindex');
      } else if (docked && line > 24) {
        slot.dataset.docked = 'false';
        logo?.setAttribute('tabindex', '-1');
      }
      const stuck = line <= 0.5 ? 'true' : 'false';
      if (slot.dataset.stuck !== stuck) slot.dataset.stuck = stuck;
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    document.addEventListener('astro:after-swap', update);
  }

  /* ---------- Page changes ----------
     Hero, flaps and footer persist, so only the page body swaps. The current flap follows
     <html data-page> (its colours and height transition), and if you left from the docked view you
     land in the docked view of the new page, with the hero just above you. */
  const currentPage = () => document.documentElement.dataset.page;

  const syncCurrent = () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-flap-link]').forEach((link) => {
      if (link.dataset.pageLink === currentPage()) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  };

  let landDocked = false;
  document.addEventListener('astro:after-swap', () => {
    syncCurrent();
    if (landDocked && slot) {
      const line = slot.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({ top: line, behavior: 'instant' });
    }
    landDocked = false;
  });

  function go(link: HTMLAnchorElement) {
    const samePath = new URL(link.href).pathname === location.pathname;
    if (link.dataset.pageLink === currentPage() && samePath) {
      // Already here: back to the top of this page.
      window.scrollTo({ top: 0, behavior: reduced.matches ? 'auto' : 'smooth' });
      return;
    }
    landDocked = slot?.dataset.docked === 'true';
    navigate(link.href);
  }

  /* ---------- Press and release ----------
     Press: the flap darkens to its Pressed colour, stands 80 tall and shrinks to 96%.
     Release: it springs back to full size, then the page changes. */
  const PRESS_RELEASE_MS = 220;

  document.querySelectorAll<HTMLAnchorElement>('[data-flap-link]').forEach((link) => {
    const release = () => link.removeAttribute('data-pressed');

    link.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      link.setAttribute('data-pressed', '');
    });
    link.addEventListener('pointerup', release);
    link.addEventListener('pointercancel', release);
    link.addEventListener('pointerleave', release);

    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      release();
      window.setTimeout(() => go(link), reduced.matches ? 0 : PRESS_RELEASE_MS);
    });
  });

  /* ---------- Logo: home, to the hero ----------
     Both logos (hero and docked) go to Work with the hero in view: on Work it scrolls back to the
     top; from another page it changes page without landing docked (the router starts at the top). */
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const home = target.closest<HTMLAnchorElement>('a[data-home]');
    if (!home || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    if (currentPage() === 'work') {
      window.scrollTo({ top: 0, behavior: reduced.matches ? 'auto' : 'smooth' });
      return;
    }
    landDocked = false;
    navigate(home.href);
  });
</script>

<style is:global>
  /* ===== Flap nav sizes =====
     One flap is 240 wide at desktop and shrinks so logo + gap + three flaps fit the docked bar.
     Height follows width (66/240) but never drops below 48px, so it stays tappable on phones. */
  /* Figma Hero / Docked Navigation (4029:2506, 4058:2752).
     Desktop: 200x56 flaps (64 when grown) in a 600 row; docked, the 48px logo sits at the left of the
     1240 bar, centred on the 64 height, and the flaps sit at the right.
     Mobile (<768): 119x44 flaps (56 when grown) fill the width minus 16px margins; no docked logo. */
  :root {
    --dock-margin: 16px;
    --dock-bar: min(1240px, 100vw - 2 * var(--dock-margin));
    --flap-unit: calc(var(--dock-bar) / 3);
    --flap-row: calc(3 * var(--flap-unit));
    --flap-h: 44px;
    --flap-h-tall: 56px;
    --flap-lift: calc((var(--flap-h-tall) - var(--flap-h)) / 2);
    --flap-grow: calc(56 / 44);
    --dock-shift: calc((var(--dock-bar) - var(--flap-row)) / 2);
    --dock-logo: 48px;
    --flap-hinge-ms: 760ms;
    --flap-stagger-ms: 80ms;
    --ease-hinge: cubic-bezier(0.55, 0, 0.15, 1);
    --ease-release: cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  @media (min-width: 768px) {
    :root {
      --dock-margin: 32px;
      --flap-unit: min(200px, (var(--dock-bar) - 64px) / 3);
      --flap-h: 56px;
      --flap-h-tall: 64px;
      --flap-grow: calc(64 / 56);
    }
  }

  .flap__shape--desktop {
    display: none !important;
  }

  @media (min-width: 768px) {
    .flap__shape--desktop {
      display: block !important;
    }

    .flap__shape--mobile {
      display: none !important;
    }
  }

  /* ===== Slot: a zero-height sticky line between the hero and the page ===== */
  .flap-slot {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    width: 100%;
    height: 0;
  }

  .flap-nav {
    position: absolute;
    inset: 0 0 auto;
    height: 0;
  }

  /* ===== Scroll-edge blur: content softens as it slides under the docked flaps ===== */
  /* The page colour fills the band behind the flaps, so content disappears under them, then fades
     out over the 48px just below their bottom edge, where the blur also eases off. */
  .flap-edge {
    position: fixed;
    inset: 0 0 auto;
    height: calc(var(--flap-h) + 48px + env(safe-area-inset-top, 0px));
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--motion-duration-base) var(--motion-ease-fade);
    background: linear-gradient(
      to bottom,
      var(--page-bg) 0,
      var(--page-bg) calc(var(--flap-h) + env(safe-area-inset-top, 0px)),
      color-mix(in srgb, var(--page-bg) 55%, transparent) calc(var(--flap-h) + 16px),
      transparent 100%
    );
  }

  .flap-edge__blur {
    position: absolute;
    inset: 0;
  }

  .flap-edge__blur--1 {
    backdrop-filter: blur(1px);
    -webkit-backdrop-filter: blur(1px);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 16px), transparent 100%);
  }

  .flap-edge__blur--2 {
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    mask-image: linear-gradient(to bottom, #000 calc(var(--flap-h) + 12px), transparent calc(var(--flap-h) + 32px));
  }

  .flap-edge__blur--3 {
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    mask-image: linear-gradient(to bottom, #000 var(--flap-h), transparent calc(var(--flap-h) + 16px));
  }

  .flap-slot[data-stuck='true'] .flap-edge {
    opacity: 1;
  }

  /* ===== Docked logo (Figma Logo/Size=Small, 48px, centred on the 64 bar). Not on phones. ===== */
  .flap-logo {
    position: absolute;
    top: calc((var(--flap-h-tall) - var(--dock-logo)) / 2);
    left: calc(50% - var(--dock-bar) / 2);
    width: var(--dock-logo);
    height: var(--dock-logo);
    display: grid;
    place-items: center;
    opacity: 0;
    scale: 0.6;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--motion-duration-base) var(--motion-ease-fade),
      scale var(--motion-duration-slow) var(--motion-ease-enter),
      visibility 0ms linear var(--motion-duration-base);
    -webkit-tap-highlight-color: transparent;
  }

  .flap-logo__spin,
  .flap-logo__mark {
    display: block;
    width: 100%;
    height: 100%;
  }

  .flap-logo__mark {
    /* The seven petals turn around (32, 33.22) of the 64 box, not its middle. */
    transform-origin: 50% 51.9%;
  }

  .flap-slot[data-docked='true'] .flap-logo {
    opacity: 1;
    scale: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: calc(3 * var(--flap-stagger-ms)), calc(3 * var(--flap-stagger-ms)), 0ms;
  }

  @media (max-width: 767px) {
    .flap-logo {
      display: none;
    }
  }

  .flap-logo:focus-visible {
    outline: 2px solid var(--color-lime-500);
    outline-offset: 4px;
    border-radius: 50%;
  }

  /* ===== Flap row ===== */
  .flap-list {
    position: absolute;
    top: 0;
    left: calc(50% - var(--flap-row) / 2);
    width: var(--flap-row);
    height: 0;
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    translate: 0 0;
    transition: translate var(--flap-hinge-ms) var(--motion-ease-enter);
  }

  .flap-slot[data-docked='true'] .flap-list {
    translate: var(--dock-shift) 0;
  }

  .flap {
    position: relative;
    flex: 0 0 var(--flap-unit);
    height: 0;
    perspective: 900px;
    perspective-origin: 50% 0;

    /* Colours per state come from the Figma variables. */
    --fill: var(--fill-idle);
    --ink: var(--ink-idle);
    --grow: 1;
    --lift: 0px;
  }

  .flap--work {
    --fill-idle: var(--color-stone-0);
    --ink-idle: var(--color-lime-900);
    --fill-hover: var(--color-stone-200);
    --ink-hover: var(--color-lime-800);
    --fill-press: var(--color-stone-700);
    --ink-press: var(--color-lime-100);
  }

  .flap--playground {
    --fill-idle: var(--color-plum-150);
    --ink-idle: var(--color-plum-900);
    --fill-hover: var(--color-plum-500);
    --ink-hover: var(--color-plum-100);
    --fill-press: var(--color-plum-700);
    --ink-press: var(--color-plum-50);
  }

  /* About: idle is Blue/200 in the hero, Blue/150 docked and when it is the current page. */
  .flap--about {
    --fill-idle: var(--color-blue-200);
    --fill-current: var(--color-blue-150);
    --ink-idle: var(--color-blue-900);
    --fill-hover: var(--color-blue-500);
    --ink-hover: var(--color-blue-100);
    --fill-press: var(--color-blue-700);
    --ink-press: var(--color-blue-50);
  }

  /* The card is the link. Its box stands on the line (bottom: 0 of a zero-height parent) and it
     hinges around that bottom edge: 0deg = hero face up, 180deg = docked face hanging below.
     Docking runs Work → About; undocking runs About → Work. */
  .flap__card {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: var(--flap-h-tall);
    display: block;
    color: inherit;
    text-decoration: none;
    transform-origin: 50% 100%;
    transform-style: preserve-3d;
    rotate: x 0deg;
    scale: 1;
    transition:
      rotate var(--flap-hinge-ms) var(--ease-hinge) calc((2 - var(--i)) * var(--flap-stagger-ms)),
      scale 420ms var(--ease-release);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .flap-slot[data-docked='true'] .flap__card {
    rotate: x 180deg;
    transition:
      rotate var(--flap-hinge-ms) var(--ease-hinge) calc(var(--i) * var(--flap-stagger-ms)),
      scale 420ms var(--ease-release);
  }

  .flap__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Authored exactly as the docked flap looks, then turned over once so the hinge turns it back. */
  .flap__face--docked {
    transform: rotateX(180deg);
  }

  .flap__shape {
    position: absolute;
    left: 0;
    width: 100%;
    height: var(--flap-h);
    display: block;
    overflow: visible;
    scale: 1 var(--grow);
    transition: scale var(--motion-duration-flap) var(--motion-ease-enter);
  }

  .flap__shape path {
    fill: var(--fill);
    transition: fill var(--motion-duration-flap) var(--motion-ease-fade);
  }

  .flap__face--hero .flap__shape {
    bottom: 0;
    transform-origin: 50% 100%;
  }

  .flap__face--docked .flap__shape {
    top: 0;
    transform-origin: 50% 0;
  }

  .flap__label {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--flap-h);
    display: grid;
    place-items: center;
    color: var(--ink);
    font-family: var(--type-nav-family);
    font-weight: var(--type-nav-weight);
    font-size: var(--type-nav-size);
    line-height: var(--type-nav-line-height);
    letter-spacing: var(--type-nav-tracking);
    white-space: nowrap;
    transition:
      translate var(--motion-duration-flap) var(--motion-ease-enter),
      color var(--motion-duration-flap) var(--motion-ease-fade);
  }

  .flap__face--hero .flap__label {
    bottom: 0;
    translate: 0 calc(-1 * var(--lift));
  }

  .flap__face--docked .flap__label {
    top: 0;
    translate: 0 var(--lift);
  }

  .flap__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ===== States ===== */
  @media (hover: hover) and (pointer: fine) {
    .flap__card:hover {
      --fill: var(--fill-hover);
      --ink: var(--ink-hover);
      --grow: var(--flap-grow);
      --lift: var(--flap-lift);
    }
  }

  .flap__card[data-pressed] {
    --fill: var(--fill-press);
    --ink: var(--ink-press);
    --grow: var(--flap-grow);
    --lift: var(--flap-lift);
    scale: 0.96;
    transition:
      rotate 0ms,
      scale 140ms var(--motion-ease-out);
  }

  /* Current page keeps its idle colours with a Medium label and stands at its grown height. */
  .flap--about .flap__card:not(:hover):not([data-pressed]) .flap__face--docked {
    --fill: var(--color-blue-150);
  }

  .flap__card[aria-current='page'] {
    --fill: var(--fill-current, var(--fill-idle));
    --ink: var(--ink-idle);
  }

  .flap__card[aria-current='page'] .flap__label {
    font-weight: var(--font-weight-medium);
  }

  .flap__card[aria-current='page'] .flap__face {
    --grow: var(--flap-grow);
    --lift: var(--flap-lift);
  }

  .flap__card:focus-visible {
    outline: none;
  }

  .flap__card:focus-visible .flap__label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .flap-list,
    .flap__card,
    .flap-slot[data-docked='true'] .flap__card,
    .flap-logo {
      transition-duration: 0ms !important;
      transition-delay: 0ms !important;
    }

    .flap__card[data-pressed] {
      scale: 1;
    }
  }
</style>
