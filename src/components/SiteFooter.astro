---
/**
 * Footer shared by every page (Figma Footer 4058:2991, Mobile Footer 4058:2464). Persisted across
 * page changes. Display headline (Heading/H1 on phones) with the mooncake polaroid tucked at the top
 * left of "Thanks", then Let's Chat (Secondary) and two Link buttons.
 */
import Button from './Button.astro';
import HedgeRow from './HedgeRow.astro';
import Polaroid from './Polaroid.astro';
import { cal, contact } from '../data/site';

// The headline rises word by word, like the hero.
const titleWords = 'Thanks for stopping by my corner of the internet.'.split(' ');
---

<footer class="site-footer" transition:persist="footer">
  <div class="footer-bg" aria-hidden="true">
    <div class="footer-blobs"></div>
    <div class="footer-grain"></div>
  </div>
  <div class="footer-copy">
    <h2 class="footer-title" data-reveal="words">
      {titleWords.map((word, w) => (
        <>
          {w > 0 && ' '}
          {w === 0 ? (
            <span class="footer-title__first">
              <Polaroid photo="cat-mooncake" class="footer-polaroid" displayWidth={102} revealDelay={420} />
              <span class="reveal-word" style="--w: 0">
                <span class="reveal-word__inner">{word}</span>
              </span>
            </span>
          ) : (
            <span class="reveal-word" style={`--w: ${w}`}>
              <span class="reveal-word__inner">{word}</span>
            </span>
          )}
        </>
      ))}
    </h2>
    <span data-reveal="rise" style="--reveal-delay: 520ms">
      <Button href={cal.url} label="Let’s Chat" variant="secondary" cal newTab />
    </span>
    <div class="footer-links">
      <span data-reveal="rise" style="--reveal-delay: 600ms">
        <Button href={contact.mail} label="Email" variant="link" icon="trailing" />
      </span>
      <span data-reveal="rise" style="--reveal-delay: 680ms">
        <Button href={contact.linkedin} label="Linkedin" variant="link" icon="trailing" newTab />
      </span>
    </div>
  </div>
  <HedgeRow place="footer" />
</footer>
