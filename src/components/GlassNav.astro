---
/**
 * Nav variation: an iOS 26-style glass toolbar in place of the flaps (turn on with ?nav=glass, off
 * with ?nav=flaps; the choice is remembered, see BaseLayout.astro).
 * Figma "Glass nav components" (4096:1748): Tab(Body) / Tab(Hero), Glass Menu (Desktop) and
 * Glass Menu (Mobile), Mobile Nav Bar (Glass / Desktop).
 * - A glass capsule pinned to the top right holds the Work, Playground and About tabs.
 * - Tabs: Nav/Default. Body (light pages): Idle Neutral/950, Hover Neutral/600, Pressed Neutral/800.
 *   Hero (over the dark hero and footer): Idle Neutral/0, Hover Neutral/400, Pressed Neutral/600.
 *   Selected: a raised bright pill (Lime/0 72% + highlights) with Nav/Active Neutral/950 text. Hover
 *   only changes the text colour; the pill stays on the selected page.
 * - Glass: #ECECEC at 20% over a 21px blur, a 0.5px dark 10% outline, a white top highlight and inner
 *   glow, a soft shadow. Chromium also bends what is behind the edge (glass-nav.ts).
 * - The name and role stay pinned top left on every screen (plain text), over a blur band.
 * - Phones and tablets (below 1024): only a glass "Menu" button. It morphs leftwards into the
 *   capsule [ Work | Playground | About | × ]; the name and role slide out meanwhile.
 */
import { withBase } from '../lib/url';
import type { NavPage } from './SiteNav.astro';

interface Props {
  current: NavPage;
}

const { current } = Astro.props;

const items = [
  { id: 'work', href: withBase('/work/'), label: 'Work' },
  { id: 'playground', href: withBase('/playground/'), label: 'Playground' },
  { id: 'about', href: withBase('/about/'), label: 'About' },
] as const;

const CLOSE =
  'M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z';
---

<div class="glass-nav" data-glass-nav>
  <nav class="glass-nav__capsule glass" aria-label="Primary" id="glass-menu" data-glass-capsule data-glass>
    <span class="glass-nav__pill" aria-hidden="true" data-glass-pill></span>
    {
      items.map((item) => (
        <a
          class="glass-nav__item"
          href={item.href}
          aria-current={current === item.id ? 'page' : undefined}
          data-glass-item
        >
          {item.label}
        </a>
      ))
    }
    <button class="glass-nav__close" type="button" aria-label="Close menu" data-glass-close>
      <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d={CLOSE} /></svg>
    </button>
  </nav>
  <button
    class="glass-nav__menu glass"
    type="button"
    aria-expanded="false"
    aria-controls="glass-menu"
    data-glass-open
    data-glass
  >
    Menu
  </button>
</div>

<script>
  import '../scripts/glass-nav';
</script>

<style>
  /* ===== Placement: pinned top right, lined up with the nav bar's right edge ===== */
  .glass-nav {
    position: fixed;
    z-index: 60;
    top: 10px;
    right: 16px;
    display: flex;
    justify-content: flex-end;
    /* Phones (Glass Menu (Mobile)): capsule padding 4, tabs 6 apart and 33 tall, Menu button 40. */
    --pad: 4px;
    --gap: 6px;
    --tab-h: 33px;
    --menu-h: 40px;
    /* Body tabs (light pages). */
    --tab-idle: var(--color-neutral-950);
    --tab-hover: var(--color-neutral-600);
    --tab-press: var(--color-neutral-800);
    --menu-ink: var(--color-stone-950);
    --close-bg: rgba(13, 13, 5, 0.08);
    --close-ink: var(--color-neutral-950);
  }

  /* Hero tabs: over the dark hero and footer (set by glass-nav.ts). */
  :global(html.glass-on-dark) .glass-nav {
    --tab-idle: var(--color-neutral-0);
    --tab-hover: var(--color-neutral-400);
    --tab-press: var(--color-neutral-600);
    --menu-ink: var(--color-neutral-0);
    --close-bg: rgba(255, 255, 255, 0.08);
    --close-ink: var(--color-neutral-0);
  }

  @media (min-width: 768px) {
    .glass-nav {
      top: 18px;
      right: max(32px, calc((100vw - 1200px) / 2));
    }
  }

  /* Desktop (Glass Menu (Desktop)): padding 6, tabs 6 apart and 40 tall, 52 overall. */
  @media (min-width: 1024px) {
    .glass-nav {
      --pad: 6px;
      --tab-h: 40px;
    }
  }

  /* ===== The glass (same on every background) ===== */
  .glass {
    position: relative;
    border: 0;
    border-radius: 999px;
    background: rgba(236, 236, 236, 0.2);
    -webkit-backdrop-filter: blur(21px);
    backdrop-filter: blur(21px);
    box-shadow:
      0 0 0 0.5px rgba(10, 10, 10, 0.1),
      0 6px 20px rgba(10, 10, 10, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      inset 0 0 12px rgba(255, 255, 255, 0.08);
  }

  /* ===== Capsule ===== */
  .glass-nav__capsule {
    display: flex;
    align-items: center;
    gap: var(--gap);
    padding: var(--pad);
  }

  /* Tab: Nav/Default, 8 x 20 padding. */
  .glass-nav__item {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    height: var(--tab-h);
    padding: 0 20px;
    border-radius: 999px;
    color: var(--tab-idle);
    font-family: var(--type-nav-family);
    font-size: var(--type-nav-size);
    line-height: var(--type-nav-line-height);
    letter-spacing: var(--type-nav-tracking);
    font-weight: 400;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.3s ease;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) and (pointer: fine) {
    .glass-nav__item:hover {
      color: var(--tab-hover);
    }
  }

  .glass-nav__item:active {
    color: var(--tab-press);
  }

  /* Selected: Nav/Active (Regular) Neutral/950 on the bright pill, on any background. */
  .glass-nav__item.is-target {
    color: var(--color-neutral-950);
  }

  .glass-nav__item:focus-visible,
  .glass-nav__close:focus-visible,
  .glass-nav__menu:focus-visible {
    outline: 2px solid var(--tab-idle);
    outline-offset: 2px;
  }

  /* The selected pill (Tab(Body), Selected): raised, near-white glass, as if closer to the light. */
  .glass-nav__pill {
    position: absolute;
    z-index: 0;
    top: var(--pad);
    left: 0;
    width: 0;
    height: var(--tab-h);
    border-radius: 999px;
    background:
      linear-gradient(to bottom, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 60%),
      color-mix(in srgb, var(--color-lime-0) 72%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 0 8px rgba(255, 255, 255, 0.45),
      0 0 0 0.5px rgba(255, 255, 255, 0.6),
      0 4px 12px rgba(10, 10, 10, 0.16),
      0 1px 2px rgba(10, 10, 10, 0.12);
    opacity: 0;
    transition:
      translate 0.42s cubic-bezier(0.3, 1.25, 0.5, 1),
      width 0.42s cubic-bezier(0.3, 1.25, 0.5, 1),
      opacity 0.25s ease;
  }

  .glass-nav__pill.is-placed {
    opacity: 1;
  }

  /* Close (phones and tablets): 32 round, at the right end of the open capsule. */
  .glass-nav__close {
    display: none;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--close-bg);
    color: var(--close-ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* Menu button (Glass Menu (Mobile), Collapsed): Nav/Default, 18 side padding, 40 tall. */
  .glass-nav__menu {
    display: none;
    height: var(--menu-h);
    padding: 0 18px;
    color: var(--menu-ink);
    font-family: var(--type-nav-family);
    font-size: var(--type-nav-size);
    line-height: var(--type-nav-line-height);
    letter-spacing: var(--type-nav-tracking);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* ===== Phones and tablets: Menu button that morphs into the capsule ===== */
  @media (max-width: 1023px) {
    .glass-nav__menu {
      display: block;
      position: absolute;
      top: 0;
      right: 0;
      transition: opacity 0.2s ease;
    }

    .glass-nav__close {
      display: grid;
    }

    /* Closed: the capsule is clipped down to the Menu button's size at its right end, and hidden. */
    .glass-nav__capsule {
      clip-path: inset(0 0 0 calc(100% - var(--menu-w, 80px)) round 999px);
      opacity: 0;
      visibility: hidden;
      transition:
        clip-path 0.45s cubic-bezier(0.3, 1.15, 0.5, 1),
        opacity 0.2s ease,
        visibility 0s linear 0.45s;
    }

    .glass-nav__capsule > * {
      opacity: 0;
      transition: opacity 0.15s ease;
    }

    :global(.site-nav.is-open) .glass-nav__capsule {
      clip-path: inset(0 0 0 0 round 999px);
      opacity: 1;
      visibility: visible;
      transition:
        clip-path 0.45s cubic-bezier(0.3, 1.15, 0.5, 1),
        opacity 0.12s ease,
        visibility 0s linear 0s;
    }

    :global(.site-nav.is-open) .glass-nav__capsule > * {
      opacity: 1;
      transition: opacity 0.25s ease 0.12s;
    }

    :global(.site-nav.is-open) .glass-nav__menu {
      opacity: 0;
      pointer-events: none;
    }
  }

  /* ===== The name and role stay pinned top left with the toolbar, on every screen =====
     Plain text (no glass). Phones: 16 from the left, 10 from the top, beside the Menu button.
     Desktop: lined up with the capsule's centre line and the bar's left edge. A blur band behind the
     top of the screen (SiteNav.astro) lets content pass under them. */
  :global(html[data-navstyle='glass']) :global(.site-nav__lead) {
    position: fixed;
    z-index: 60;
    top: 10px;
    left: 16px;
    margin: 0;
  }

  @media (min-width: 768px) {
    :global(html[data-navstyle='glass']) :global(.site-nav__lead) {
      top: 14px;
      left: max(32px, calc((100vw - 1200px) / 2));
    }
  }

  /* Ink follows what is under the bar: light text over the hero and footer, the page's own inks
     elsewhere (Home's light section uses Work's stone inks). */
  :global(html[data-navstyle='glass'][data-page='home']:not(.glass-on-dark)) :global(.site-nav) {
    --nav-name: var(--color-stone-950);
    --nav-role: var(--color-stone-700);
  }

  :global(html[data-navstyle='glass'].glass-on-dark) :global(.site-nav) {
    --nav-name: var(--color-neutral-0);
    --nav-role: var(--color-stone-400);
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-nav__pill,
    .glass-nav__capsule,
    .glass-nav__capsule > *,
    .glass-nav__menu {
      transition: none !important;
    }
  }
</style>
