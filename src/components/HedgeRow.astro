---
import { footerHedges, heroHedges } from '../data/hedges';

interface Props {
  place: 'hero' | 'footer';
}

const { place } = Astro.props;
const set = place === 'hero' ? heroHedges : footerHedges;
// Stacking from Figma (4026:599, 4026:1167): the N bush is the bottom layer, the rest stack left to right.
const stack = [1, 2, 3, 4, 0, 5, 6];
---

<div
  class:list={['hedge-row', `hedge-row--${place}`]}
  data-hedge-row
  style={`--canvas-w: ${set.width}; --canvas-h: ${set.height};`}
>
  {
    set.bushes.map((bush, index) => (
      <button
        type="button"
        class="hedge"
        data-hedge
        aria-label={`Hedge letter ${bush.letter}`}
        style={`--x: ${bush.x}; --y: ${bush.y}; --w: ${bush.w}; --h: ${bush.h}; --z: ${stack[index] ?? index};`}
      >
        <span class="hedge__plant">
          <svg viewBox={`${bush.x} ${bush.y} ${bush.w} ${bush.h}`} aria-hidden="true" focusable="false">
            {bush.paths.map((path) => (
              <path d={path.d} fill={path.fill} />
            ))}
          </svg>
        </span>
      </button>
    ))
  }
</div>

<script>
  const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  function play(plant: HTMLElement, kind: 'shake' | 'rustle') {
    plant.classList.remove('is-shaking', 'is-rustling', 'is-settling');
    void plant.offsetWidth;
    if (reducedQuery.matches) {
      if (kind === 'shake') plant.classList.add('is-settling');
      return;
    }
    plant.classList.add(kind === 'shake' ? 'is-shaking' : 'is-rustling');
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest('[data-hedge]');
    if (!(button instanceof HTMLButtonElement)) return;
    const row = button.closest('[data-hedge-row]');
    if (!row) return;
    const hedges = [...row.querySelectorAll('[data-hedge]')];
    const index = hedges.indexOf(button);
    hedges.forEach((hedge, hedgeIndex) => {
      const distance = Math.abs(hedgeIndex - index);
      if (distance > 1) return;
      const plant = hedge.querySelector('.hedge__plant');
      if (!(plant instanceof HTMLElement)) return;
      play(plant, distance === 0 ? 'shake' : 'rustle');
    });
  });

  document.addEventListener('animationend', (event) => {
    const plant = event.target;
    if (!(plant instanceof HTMLElement) || !plant.classList.contains('hedge__plant')) return;
    plant.classList.remove('is-shaking', 'is-rustling', 'is-settling');
  });
</script>
