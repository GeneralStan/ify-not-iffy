---
/**
 * Hedge row from the Figma component set "Hedges" (4029:2552).
 * Both breakpoints are rendered; CSS shows the Desktop variant from 768px up and the Mobile one below.
 * Bushes keep Figma's layer order (the N bush is the bottom layer), so DOM order = stacking.
 * Motion: the whole row pops up from behind the bottom edge at once (see home.css, hedge-pop).
 */
import {
  footerHedges,
  footerHedgesMobile,
  heroHedges,
  heroHedgesMobile,
  type HedgeSet,
} from '../data/hedges';

interface Props {
  place: 'hero' | 'footer';
}

const { place } = Astro.props;
const variants: Array<[string, HedgeSet]> =
  place === 'hero'
    ? [['desktop', heroHedges], ['mobile', heroHedgesMobile]]
    : [['desktop', footerHedges], ['mobile', footerHedgesMobile]];

// Left-to-right position of each bush, for the tap ripple to its neighbours.
const orderOf = (set: HedgeSet) => {
  const byX = set.bushes.map((bush, index) => ({ x: bush.x, index })).sort((a, b) => a.x - b.x);
  const order: number[] = [];
  byX.forEach((entry, rank) => (order[entry.index] = rank));
  return order;
};
---

<div class:list={['hedges', `hedges--${place}`]} data-hedges={place}>
  {
    variants.map(([breakpoint, set]) => {
      const order = orderOf(set);
      return (
        <div
          class:list={['hedge-row', `hedge-row--${breakpoint}`]}
          data-hedge-row
          style={`--canvas-w: ${set.width}; --canvas-h: ${set.height};`}
        >
          {set.bushes.map((bush, index) => (
            <button
              type="button"
              class="hedge"
              data-hedge
              data-order={order[index]}
              aria-label={`Hedge letter ${bush.letter}`}
              style={`--x: ${bush.x}; --y: ${bush.y}; --w: ${bush.w}; --h: ${bush.h};`}
            >
              <span class="hedge__plant">
                <svg viewBox={bush.vb} preserveAspectRatio="none" aria-hidden="true" focusable="false" set:html={bush.inner} />
              </span>
            </button>
          ))}
        </div>
      );
    })
  }
</div>

<script>
  const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  function play(plant: HTMLElement, kind: 'shake' | 'rustle') {
    plant.classList.remove('is-shaking', 'is-rustling', 'is-settling');
    void plant.offsetWidth;
    if (reducedQuery.matches) {
      if (kind === 'shake') plant.classList.add('is-settling');
      return;
    }
    plant.classList.add(kind === 'shake' ? 'is-shaking' : 'is-rustling');
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLElement>('[data-hedge]');
    const row = button?.closest('[data-hedge-row]');
    if (!button || !row) return;
    const at = Number(button.dataset.order);
    row.querySelectorAll<HTMLElement>('[data-hedge]').forEach((hedge) => {
      const distance = Math.abs(Number(hedge.dataset.order) - at);
      if (distance > 1) return;
      const plant = hedge.querySelector<HTMLElement>('.hedge__plant');
      if (plant) play(plant, distance === 0 ? 'shake' : 'rustle');
    });
  });

  /* Footer: the row pops up out of the bottom edge the first time the footer shows.
     Hidden only once JS has armed it, so without JS (or with reduced motion) the hedges simply sit there. */
  const footer = document.querySelector<HTMLElement>('[data-hedges="footer"]');
  if (footer && !reducedQuery.matches && 'IntersectionObserver' in window) {
    footer.classList.add('is-armed');
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        footer.classList.add('is-popped');
        observer.disconnect();
      },
      { threshold: 0.3 },
    );
    footer.querySelectorAll('[data-hedge-row]').forEach((row) => observer.observe(row));
  }

  document.addEventListener('animationend', (event) => {
    const plant = event.target;
    if (!(plant instanceof HTMLElement) || !plant.classList.contains('hedge__plant')) return;
    plant.classList.remove('is-shaking', 'is-rustling', 'is-settling', 'is-idling');
  });

  /* Hero idle: every 6s while the hero is on screen, one bush sways gently (softer than the tap
     shake) so the row feels alive and hints that it can be tapped. Bushes take turns in a shuffled
     order, never the same one twice in a row. Skipped for reduced motion, while the tab is hidden,
     during the load-in, and while a case study or image is open over the page. */
  const heroHedges = document.querySelector<HTMLElement>('[data-hedges="hero"]');
  if (heroHedges && !reducedQuery.matches) {
    let onScreen = false;
    let bag: HTMLElement[] = [];
    let last: HTMLElement | null = null;

    new IntersectionObserver((entries) => (onScreen = entries.some((entry) => entry.isIntersecting))).observe(heroHedges);

    const plants = () => {
      const row = [...heroHedges.querySelectorAll<HTMLElement>('[data-hedge-row]')].find((r) => r.offsetParent !== null);
      return row ? [...row.querySelectorAll<HTMLElement>('.hedge__plant')] : [];
    };

    window.setInterval(() => {
      const root = document.documentElement;
      if (!onScreen || document.hidden) return;
      if (root.classList.contains('intro-wait') || root.classList.contains('intro-play')) return;
      if (root.classList.contains('has-case-sheet') || root.classList.contains('has-play-zoom')) return;
      if (!bag.length) {
        bag = plants().sort(() => Math.random() - 0.5);
        if (bag[0] === last && bag.length > 1) bag.push(bag.shift()!);
      }
      const plant = bag.shift();
      if (!plant || plant.classList.contains('is-shaking') || plant.classList.contains('is-rustling')) return;
      last = plant;
      plant.classList.add('is-idling');
    }, 6000);
  }
</script>
