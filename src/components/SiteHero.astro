---
/**
 * Hero shared by every page (Figma Hero 4058:2919, Mobile Hero 4058:2783): solid Lime/900.
 * It is persisted across page changes (transition:persist), so it never reloads or replays.
 * The headline is split into words so the load-in can reveal them one by one.
 */
import Button from './Button.astro';
import { withBase } from '../lib/url';
import HedgeRow from './HedgeRow.astro';
import Polaroid from './Polaroid.astro';
import IffyLogo from '../assets/home/iffy-logo.svg';
import { cal, contact } from '../data/site';

// [colour, text] runs per line, as in Figma Hero 4058:2919 (Lime/300 at 60% vs Neutral/0).
const lines: Array<Array<['lime' | 'paper', string]>> = [
  [['lime', 'Hi, I’m'], ['paper', 'Ifeanyi Ulasika.']],
  [['lime', 'I design'], ['paper', 'products'], ['lime', 'and build']],
  [['paper', 'systems that ship.']],
];

let wordIndex = 0;
const words = lines.map((runs) =>
  runs.flatMap(([tone, text]) => text.split(' ').map((word) => ({ tone, word, index: wordIndex++ }))),
);
---

<section class="hero" id="hero" data-hero transition:persist="hero">
  <div class="hero-clip">
    <div class="hero-copy">
      <a class="hero-logo" href={withBase('/')} data-spin data-home aria-label="Ifeanyi Ulasika, Work">
        <IffyLogo class="hero-logo__mark" width="64" height="64" aria-hidden="true" />
      </a>
      <h1 class="hero-title text-display" data-headline>
        {
          words.map((line, l) => (
            <>
            {l > 0 && ' '}
            <span class="hero-line" data-line>
              <span class="hero-line__inner">
                {line.map(({ tone, word, index }, i) => (
                  <>
                    {word === 'build' && <br class="hero-br--mobile" />}
                    <span class={`hero-word ${tone}`} style={`--w: ${index}`}>
                      <span class="hero-word__inner">{word}</span>
                    </span>
                    {i < line.length - 1 ? ' ' : ''}
                  </>
                ))}
              </span>
            </span>
            </>
          ))
        }
        <Polaroid photo="at-sea" class="hero-polaroid" displayWidth={132} eager />
      </h1>
      <div class="hero-cta">
        <Button href={cal.url} label="Let’s Chat" variant="secondary" cal newTab />
        <Button href={contact.resume} label="View resume" variant="primary" newTab />
      </div>
    </div>
    <HedgeRow place="hero" />
  </div>
</section>
