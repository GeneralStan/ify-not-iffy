---
/**
 * Home hero (Figma Home 4068:6024 hero 4068:6051, Mobile Hero 4068:7252): solid Lime/900.
 * "I design experiences / engineer systems / & build products", with the at-sea polaroid tucked on
 * "experiences" and the ampersand sticker by "build", then "Scroll to view work" and the hedges.
 * Each run rises in on load; see the inline load-in script in BaseLayout.astro and home.css.
 */
import { Image } from 'astro:assets';
import HedgeRow from './HedgeRow.astro';
import Polaroid from './Polaroid.astro';
import ampersand from '../assets/home/hero-ampersand.png';

// [tone, text] runs per line (Figma Hero 4094:794): Neutral/0, then each highlight in its own colour:
// experiences #FDC45E (light amber), systems #DA9BE5 (lilac), products Lime/400 (#A4CA3A).
const lines: Array<Array<['paper' | 'amber' | 'lilac' | 'lime', string]>> = [
  [['paper', 'I design'], ['amber', 'experiences']],
  [['paper', 'engineer'], ['lilac', 'systems']],
  [['paper', 'build'], ['lime', 'products']],
];

// "Scroll to view work" is revealed last, as pixels: a 34 x 6 grid of hero-coloured squares covers
// it and each drops away in turn, top rows first with some jitter, over about 2.4s (home.css).
// Delays are seeded so the pattern is the same on every load and in the built HTML.
const PIXEL_COLS = 34;
const PIXEL_ROWS = 6;
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const pixels = Array.from({ length: PIXEL_COLS * PIXEL_ROWS }, (_, i) => {
  const row = Math.floor(i / PIXEL_COLS);
  return Math.round((row / (PIXEL_ROWS - 1)) * 1500 + rand() * 700);
});

let runIndex = 0;
const runs = lines.map((line) => line.map(([tone, text]) => ({ tone, text, index: runIndex++ })));
---

<section class="hero" id="hero" data-hero>
  <div class="hero-clip">
    <div class="hero-copy">
      <h1 class="hero-title" data-headline>
        {
          runs.map((line, l) => (
            <>
              {l > 0 && ' '}
              <span class="hero-line">
                {line.map(({ tone, text, index }, i) => (
                  <>
                    {i > 0 && ' '}
                    <span class={`hero-word ${tone}`} style={`--w: ${index}`}>
                      {text === 'experiences' && (
                        <Polaroid photo="at-sea" class="hero-polaroid" displayWidth={116} eager />
                      )}
                      {text === 'build' && (
                        <Image class="hero-amp" src={ampersand} alt="&" width={127} height={173} loading="eager" />
                      )}
                      <span class="hero-word__mask">
                        <span class="hero-word__inner">{text}</span>
                      </span>
                    </span>
                  </>
                ))}
              </span>
            </>
          ))
        }
      </h1>
      <p class="hero-scroll">
        Scroll to view work
        <span class="pixel-mask" aria-hidden="true" style={`--cols: ${PIXEL_COLS}; --rows: ${PIXEL_ROWS};`}>
          {pixels.map((d) => <span style={`--d: ${d}ms`}></span>)}
        </span>
      </p>
    </div>
    <HedgeRow place="hero" />
  </div>
</section>
