---
import { getCollection } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';

export async function getStaticPaths() {
  const studies = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  // Previous / Next only link written case studies; a Coming Soon one gets no links of its own.
  const published = studies.filter((s) => !s.data.comingSoon);
  return studies.map((study) => {
    const index = published.indexOf(study);
    return {
      params: { slug: study.id },
      props: {
        study,
        prev: index > 0 ? published[index - 1] : null,
        next: index >= 0 ? (published[index + 1] ?? null) : null,
      },
    };
  });
}

const { study, prev, next } = Astro.props;
---

<CaseStudy study={study} prev={prev} next={next} />
