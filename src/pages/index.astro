---
import SiteLayout from '../layouts/SiteLayout.astro';
import { assetSrc } from '../lib/url';
import shot from '../assets/home/project-screenshot-2026-11-17.png';

const shotSrc = assetSrc(shot);

// Figma "Work (Final)" 4026:619. Cards 1 and 3 sit in the left column; 2 and 4 in the right, 124px lower.
const projects = [
  {
    tags: ['Leta Technologies', 'Web', 'B2B'],
    title: 'Rebuilding Leta’s dispatch dashboard as a working prototype ops teams could test before launch.',
  },
  {
    tags: ['Leta Technologies', 'Web', 'B2B'],
    title: 'Redesigning the Driver App to decrease order fulfilment time and boost driver retention.',
  },
  {
    tags: ['Leta Technologies', 'Mobile', 'B2B'],
    title: 'Redesigning the Driver App to decrease order fulfilment time and boost driver retention.',
  },
  {
    tags: ['Leta Technologies', 'Mobile', 'B2C'],
    title: 'Enabling users to purchase everyday essentials within 30 minutes.',
  },
].map((project, index) => ({ ...project, n: index + 1 }));

const columns = [projects.filter((p) => p.n % 2 === 1), projects.filter((p) => p.n % 2 === 0)];
---

<SiteLayout
  page="work"
  title="Ifeanyi Ulasika — Product designer"
  description="Ifeanyi Ulasika designs products and builds systems that deploy. Selected work in enterprise design systems, web, and mobile."
>
  <section class="projects" id="work" data-section="work">
    <div class="projects-inner">
      <header class="projects-head">
        <h2 class="projects-title text-h1">Selected projects</h2>
        <p class="projects-sub text-h2">
          Enterprise design systems,<br />
          web and mobile products
        </p>
      </header>
      <div class="card-board">
        {
          columns.map((column, c) => (
            <div class={`card-column card-column--${c + 1}`}>
              {column.map((project) => (
                <article class="project-card" style={`--order: ${project.n}`}>
                  <div class="project-card__media">
                    <img class="project-card__shot" src={shotSrc} alt="" />
                  </div>
                  <div class="project-card__copy">
                    <p class="project-card__tags text-meta">
                      {project.tags.map((tag, i) => (
                        <>
                          {i > 0 && <span aria-hidden="true">·</span>}
                          <span>{tag}</span>
                        </>
                      ))}
                    </p>
                    <h3 class="project-card__title">{project.title}</h3>
                  </div>
                </article>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>
