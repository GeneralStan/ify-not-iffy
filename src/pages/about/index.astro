---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Polaroid from '../../components/Polaroid.astro';
import { aboutIntro, aboutStrip, experience } from '../../data/about';
---

<SiteLayout
  page="about"
  title="About — Ifeanyi Ulasika"
  description="Ifeanyi Ulasika is a multidisciplinary product designer with over 6 years of experience across logistics, quick commerce and design systems."
>
  <section class="page-section about">
    <header class="section-head">
      <h2 class="section-title text-h1" data-reveal="soft">{aboutIntro.title}</h2>
      <p class="section-lead text-h3" data-reveal="soft" style="--reveal-delay: 100ms">{aboutIntro.lead}</p>
    </header>

    <!-- The row drifts left to right in an endless loop (three copies of the six photos, so the
         screen is always covered); it pauses while a pointer or finger is on it. -->
    <div class="about-strip" aria-hidden="true" data-about-strip>
      <div class="about-strip__track">
        {
          [0, 1, 2].map((copy) =>
            aboutStrip.map((p) => (
              <span class="about-strip__slot">
                <Polaroid
                  photo={p.photo}
                  class="about-strip__photo"
                  displayWidth={175}
                  style={`--pol-rotate: ${p.rot}deg;`}
                />
              </span>
            )),
          )
        }
      </div>
    </div>

    <div class="about-intro">
      <div class="about-copy">
        {
          aboutIntro.paragraphs.map((text) => (
            <p class="about-copy__p text-h3" data-reveal="rise">{text}</p>
          ))
        }
      </div>
    </div>

    <div class="experience">
      <h2 class="section-title text-h1" data-reveal="soft">Experience</h2>
      <ol class="experience-list">
        {
          experience.map((job) => (
            <li class="job">
              <div class="job__head" data-reveal="rise">
                <h3 class="job__title text-h3">
                  {job.company} — {job.summary}
                  {job.note && <span class="job__note">{job.note}</span>}
                </h3>
                <p class="job__meta text-meta">
                  {job.role}
                  <br />
                  {job.place}
                </p>
              </div>
              <ul class="job__points" data-reveal="rise" style="--reveal-delay: 100ms">
                {job.points.map((point) => (
                  <li class="text-body-lg">{point}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</SiteLayout>

<script>
  /* Touch has no hover: hold a finger on the row to pause it (pointer hover pauses it in CSS). */
  const strip = document.querySelector<HTMLElement>('[data-about-strip]');
  if (strip) {
    const hold = (on: boolean) => () => strip.classList.toggle('is-held', on);
    strip.addEventListener('pointerdown', hold(true));
    ['pointerup', 'pointercancel', 'pointerleave'].forEach((type) => strip.addEventListener(type, hold(false)));
  }
</script>
