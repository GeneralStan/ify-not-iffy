---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StudyMedia from '../../components/StudyMedia.astro';
import { categories, layoutRows, pieces, playgroundHead, rowPattern } from '../../data/playground';
import badgeGold from '../../assets/playground/badges/badge-gold.svg?raw';
import badgeSilver from '../../assets/playground/badges/badge-silver.svg?raw';
import badgeBronze from '../../assets/playground/badges/badge-bronze.svg?raw';

// The back of each coin is the same badge without its number (the last <text> or <path>).
const blankBack = (svg: string) =>
  /<text[\s\S]*<\/text>/.test(svg) ? svg.replace(/<text[\s\S]*<\/text>/, '') : svg.replace(/<path(?![\s\S]*<path)[^>]*\/>/, '');
const medals = [badgeGold, badgeSilver, badgeBronze].map((front) => ({ front, back: blankBack(front) }));
// Two runs of the three badges, so the track can loop without a seam.
const badges = [...medals, ...medals];

// Figma "Playground — layout explorations", Variation D (rows + filters). The first render uses the
// desktop row order with every piece; the script below lays the tiles out again for phones and
// whenever a filter is picked (same layoutRows() as here).
const rows = layoutRows(pieces.length, rowPattern.desktop);
let next = 0;
const grouped = rows.map((row) => {
  const items = pieces.slice(next, next + row.size).map((piece, k) => ({ piece, index: next + k }));
  next += row.size;
  return { ...row, items };
});
---

<SiteLayout
  page="playground"
  title="Playground — Ifeanyi Ulasika"
  description="Experiments and side projects Ifeanyi Ulasika built in his spare time: motion, product, 3D and illustration."
>
  <section class="page-section playground">
    <header class="section-head play-head">
      <h2 class="section-title text-h1" data-reveal="soft">{playgroundHead.title}</h2>
      <p class="section-lead text-h3" data-reveal="soft" style="--reveal-delay: 100ms">{playgroundHead.lead}</p>
      <div class="play-filters" role="group" aria-label="Show" data-reveal="soft" style="--reveal-delay: 180ms">
        <button type="button" class="play-filter text-label-md" aria-pressed="true" data-filter="all">All</button>
        {
          categories.map((category) => (
            <button type="button" class="play-filter text-label-md" aria-pressed="false" data-filter={category}>
              {category}
            </button>
          ))
        }
      </div>
    </header>

    <div
      class="play-grid"
      data-play-grid
      data-pattern-desktop={JSON.stringify(rowPattern.desktop)}
      data-pattern-mobile={JSON.stringify(rowPattern.mobile)}
    >
      {
        grouped.map((row) => (
          <div class={`play-row play-row--${row.type}`}>
            {row.items.map(({ piece, index }) => (
              <div
                class="play-tile"
                data-play-tile
                data-index={index}
                data-cats={piece.categories.join('|')}
                role="img"
                aria-label={piece.title.replace(/^\[TBD: (.*)\]$/, '$1')}
              >
                <span class="play-tile__stage" data-media-reveal>
                  <span
                    class:list={['play-tile__preview', piece.placeholder && 'is-placeholder', piece.transparent && 'is-transparent', piece.badges && 'is-fill']}
                    data-play-preview
                    style={`--aspect: ${piece.aspect};`}
                  >
                    {piece.badges && (
                      <span class="play-badges" aria-hidden="true">
                        <span class="play-badges__track">
                          {badges.map((medal, i) => (
                            <span class="play-badge" style={`--i: ${i % 3};`}>
                              <span class="play-badge__coin">
                                <span class="play-badge__face" set:html={medal.front} />
                                <span class="play-badge__face play-badge__face--back" set:html={medal.back} />
                              </span>
                            </span>
                          ))}
                        </span>
                      </span>
                    )}
                    {piece.image && <img src={piece.image.src} alt="" loading="lazy" decoding="async" draggable="false" />}
                    {piece.video && (
                      <StudyMedia
                        kind="video"
                        frame="card"
                        src={piece.video.src}
                        webm={piece.video.webm}
                        poster={piece.video.poster}
                      />
                    )}
                  </span>
                </span>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </section>

</SiteLayout>

<script>
  /*
   * Playground: rows and filters.
   * - Rows: tiles are grouped into rows (full, two, three, bento) in the order set per breakpoint in
   *   src/data/playground.ts, again whenever the screen crosses 768px or a filter is picked.
   * - Filters: only the matching pieces stay, laid out with the same row order, with a quick fade.
   * - Tiles don't open or expand (removed Nov 28, 2026, at the owner's request).
   */
  import { layoutRows, type RowType } from '../../data/playground';

  const grid = document.querySelector<HTMLElement>('[data-play-grid]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const phone = window.matchMedia('(max-width: 767px)');

  if (grid) {
    const tiles = [...grid.querySelectorAll<HTMLElement>('[data-play-tile]')].sort(
      (a, b) => Number(a.dataset.index) - Number(b.dataset.index),
    );
    const patterns = {
      desktop: JSON.parse(grid.dataset.patternDesktop ?? '["full"]') as RowType[],
      mobile: JSON.parse(grid.dataset.patternMobile ?? '["full"]') as RowType[],
    };
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    let filter = 'all';
    let swapTimer = 0;

    /* ----- Rows ----- */
    function layout() {
      const shown = tiles.filter((tile) => filter === 'all' || tile.dataset.cats!.split('|').includes(filter));
      const rows = layoutRows(shown.length, phone.matches ? patterns.mobile : patterns.desktop);
      const built: HTMLElement[] = [];
      let next = 0;
      for (const row of rows) {
        const el = document.createElement('div');
        el.className = `play-row play-row--${row.type}`;
        el.append(...shown.slice(next, next + row.size));
        next += row.size;
        built.push(el);
      }
      grid!.replaceChildren(...built);
      // Tiles left out keep their videos paused (StudyMedia only plays what is on screen).
      tiles.filter((tile) => !shown.includes(tile)).forEach((tile) => tile.querySelector('video')?.pause());
    }

    function pick(next: string) {
      if (next === filter) return;
      filter = next;
      filters.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === next)));
      if (reduced.matches) {
        layout();
        return;
      }
      // Fade out, swap the rows, fade back in. Timed, not chained on the animation's promise, so the
      // swap always happens even if the fade is cut short.
      grid!.getAnimations().forEach((animation) => animation.cancel());
      grid!.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 120, easing: 'ease-in', fill: 'forwards' });
      window.clearTimeout(swapTimer);
      swapTimer = window.setTimeout(() => {
        layout();
        grid!.getAnimations().forEach((animation) => animation.cancel());
        grid!.animate(
          [
            { opacity: 0, transform: 'translateY(8px)' },
            { opacity: 1, transform: 'none' },
          ],
          { duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        );
      }, 120);
    }

    filters.forEach((button) => button.addEventListener('click', () => pick(button.dataset.filter ?? 'all')));
    phone.addEventListener('change', layout);
    if (phone.matches) layout();
  }
</script>
