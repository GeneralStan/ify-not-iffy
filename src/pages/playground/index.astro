---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { PLAYGROUND_HEIGHT, PLAYGROUND_PERIOD, playground, playgroundHead } from '../../data/playground';

// Figma Playground 4068:7511. The board repeats every PLAYGROUND_PERIOD px; four copies (-1 to 2) keep
// the screen covered while it drifts or is dragged. Only copy 0 is in the tab order and the
// accessibility tree.
const copies = [-1, 0, 1, 2];
const CLOSE =
  'M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z';
---

<SiteLayout
  page="playground"
  title="Playground — Ifeanyi Ulasika"
  description="Experiments and side projects Ifeanyi Ulasika built in his spare time: animation, illustration and branding."
>
  <section class="page-section playground">
    <div
      class="play-canvas"
      data-play-canvas
      tabindex="0"
      role="region"
      aria-label="Playground board. It drifts sideways; drag it, or use the left and right arrow keys, to explore. Select a card to zoom in."
      style={`--period: ${PLAYGROUND_PERIOD}; --board-h: ${PLAYGROUND_HEIGHT};`}
    >
      <header class="section-head play-head" data-play-head>
        <h2 class="section-title text-h1" data-reveal="soft">{playgroundHead.title}</h2>
        <p class="section-lead text-h3" data-reveal="soft" style="--reveal-delay: 100ms">{playgroundHead.lead}</p>
      </header>
      <div class="play-board" data-play-board>
        {
          copies.map((copy) =>
            playground.map((card, i) => (
              <button
                type="button"
                class="play-card"
                data-play-card
                aria-hidden={copy === 0 ? undefined : 'true'}
                tabindex={copy === 0 ? undefined : -1}
                aria-label={copy === 0 ? `Zoom in on project ${i + 1}: ${card.tags.join(', ')}` : undefined}
                style={`--x: ${card.x + copy * PLAYGROUND_PERIOD}; --y: ${card.y}; --w: ${card.w}; --media-h: ${card.mediaH};`}
              >
                <span class="play-card__media" data-skeleton>
                  {card.image && <img src={card.image.src} alt="" loading="lazy" decoding="async" draggable="false" />}
                </span>
                <span class="play-card__tags text-meta-lg">
                  {card.tags.map((tag, t) => (
                    <>
                      {t > 0 && <span aria-hidden="true">·</span>}
                      <span>{tag}</span>
                    </>
                  ))}
                </span>
              </button>
            )),
          )
        }
      </div>
    </div>
  </section>

  <template id="play-zoom-close">
    <button type="button" class="overlay-close play-zoom__close" aria-label="Close" data-zoom-close>
      <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d={CLOSE} /></svg>
    </button>
  </template>
</SiteLayout>

<script>
  /*
   * Playground board.
   * - Drifts left to right in an endless loop (about 30px a second), like the About polaroids.
   * - Pauses while the pointer is over a card or a card is held (touch or mouse), while a card is
   *   zoomed, while the board is off screen, and for reduced motion. The empty board keeps drifting,
   *   even while it is being dragged.
   * - Drag sideways to pan (with a little glide); up and down swipes scroll the page.
   * - Tap or select a card: it zooms to fit the screen (never past its real size) over a frosted
   *   backdrop; close with the outlined ×, Escape, or a tap on the backdrop.
   */
  const canvas = document.querySelector<HTMLElement>('[data-play-canvas]');
  const board = canvas?.querySelector<HTMLElement>('[data-play-board]');
  const head = canvas?.querySelector<HTMLElement>('[data-play-head]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const DRIFT = 30; // px per second, on screen

  if (canvas && board) {
    const period = parseFloat(getComputedStyle(canvas).getPropertyValue('--period'));
    const scale = () => parseFloat(getComputedStyle(board).getPropertyValue('--s')) || 1;

    let x = 0;
    let hovering = false; // pointer over a card
    let holding = false; // a card is pressed
    let dragHold = false; // the board is being dragged
    let zoomed = false;
    let onScreen = true;
    let glideV = 0;
    let last = performance.now();

    /* Board top: the heading's bottom plus Figma's 56 gap (32 on phones). */
    function measure() {
      if (!head) return;
      const gap = canvas!.clientWidth < 768 ? 32 : 56;
      canvas!.style.setProperty('--board-top', `${head.offsetTop + head.offsetHeight + gap}px`);
    }

    function apply() {
      const span = period * scale();
      x = ((x % span) + span) % span - span; // keep x in [-span, 0): copies -1..2 cover the screen
      board!.style.translate = `${x}px 0`;
    }

    function tick(now: number) {
      const dt = Math.min(64, now - last);
      last = now;
      if (dragHold) {
        /* x follows the pointer */
      } else if (glideV) {
        x += glideV * dt;
        glideV *= Math.pow(0.94, dt / 16);
        if (Math.abs(glideV) < 0.02) glideV = 0;
      } else if (!hovering && !holding && !zoomed && onScreen && !reduced.matches) {
        x += (DRIFT * dt) / 1000;
      }
      apply();
      requestAnimationFrame(tick);
    }

    /* ----- Hovering or holding a card pauses the drift ----- */
    canvas.addEventListener('pointerover', (event) => {
      if (event.pointerType === 'mouse') hovering = !!(event.target as Element).closest('[data-play-card]');
    });
    canvas.addEventListener('pointerleave', () => (hovering = false));

    /* ----- Sideways drag ----- */
    let pointer: number | null = null;
    let startX = 0;
    let startPan = 0;
    let lastX = 0;
    let lastT = 0;
    let velocity = 0;
    let dragging = false;
    let dragged = false;

    canvas.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      pointer = event.pointerId;
      holding = !!(event.target as Element).closest('[data-play-card]');
      dragging = false;
      dragged = false;
      glideV = 0;
      startX = lastX = event.clientX;
      startPan = x;
      lastT = event.timeStamp;
      velocity = 0;
    });

    canvas.addEventListener('pointermove', (event) => {
      if (event.pointerId !== pointer) return;
      const dx = event.clientX - startX;
      if (!dragging) {
        if (Math.abs(dx) < 6) return;
        dragging = dragged = dragHold = true;
        startPan = x - dx; // pick up from wherever the drift has moved it
        try {
          canvas.setPointerCapture(event.pointerId);
        } catch {
          /* capture is a nicety */
        }
        canvas.classList.add('is-dragging');
      }
      const dt = Math.max(1, event.timeStamp - lastT);
      velocity = (event.clientX - lastX) / dt;
      lastX = event.clientX;
      lastT = event.timeStamp;
      x = startPan + dx;
      apply();
    });

    const release = (event: PointerEvent) => {
      if (event.pointerId !== pointer) return;
      pointer = null;
      holding = false;
      dragHold = false;
      canvas.classList.remove('is-dragging');
      if (dragging && !reduced.matches && event.timeStamp - lastT < 80) glideV = velocity;
      dragging = false;
    };
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);

    canvas.addEventListener('keydown', (event) => {
      if (event.target !== canvas) return;
      const step = event.shiftKey ? 240 : 80;
      if (event.key === 'ArrowLeft') x += step;
      else if (event.key === 'ArrowRight') x -= step;
      else return;
      event.preventDefault();
      board.classList.add('is-easing');
      apply();
    });
    board.addEventListener('transitionend', () => board.classList.remove('is-easing'));

    /* ----- Zoom in on a card ----- */
    const closeTemplate = document.querySelector<HTMLTemplateElement>('#play-zoom-close');

    canvas.addEventListener('click', (event) => {
      if (dragged) return;
      const card = (event.target as Element).closest<HTMLElement>('[data-play-card]');
      if (card) zoom(card);
    });

    function zoom(card: HTMLElement) {
      if (zoomed) return;
      zoomed = true;
      const from = card.getBoundingClientRect();
      const overlay = document.createElement('div');
      overlay.className = 'play-zoom';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.setAttribute('aria-label', card.getAttribute('aria-label')?.replace('Zoom in on ', '') ?? 'Project');
      const backdrop = document.createElement('div');
      backdrop.className = 'play-zoom__backdrop';
      const clone = card.cloneNode(true) as HTMLElement;
      clone.removeAttribute('data-play-card');
      clone.removeAttribute('aria-hidden');
      clone.removeAttribute('aria-label');
      clone.setAttribute('tabindex', '-1');
      clone.classList.add('play-zoom__card');
      const close = closeTemplate!.content.firstElementChild!.cloneNode(true) as HTMLButtonElement;
      overlay.append(backdrop, clone, close);
      document.body.append(overlay);
      document.documentElement.classList.add('has-play-zoom');

      const w = clone.offsetWidth;
      const h = clone.offsetHeight;
      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight;
      const fit = Math.min(1, (vw - 32) / w, (vh - 144) / h);
      const to = `translate(${(vw - w * fit) / 2}px, ${(vh - h * fit) / 2 + 24}px) scale(${fit})`;
      const start = (r: DOMRect) => `translate(${r.left}px, ${r.top}px) scale(${r.width / w})`;

      card.style.visibility = 'hidden';
      clone.style.transform = start(from);
      clone.getBoundingClientRect(); // commit the start before animating
      requestAnimationFrame(() => {
        overlay.classList.add('is-open');
        clone.style.transform = to;
      });
      (window as unknown as { __ifyFocus?: (c: HTMLElement | null, k?: HTMLElement | null) => void }).__ifyFocus?.(close, overlay);

      let closing = false;
      function done() {
        if (closing) return;
        closing = true;
        overlay.classList.remove('is-open');
        clone.style.transform = start(card.getBoundingClientRect());
        const finish = () => {
          overlay.remove();
          card.style.visibility = '';
          document.documentElement.classList.remove('has-play-zoom');
          document.removeEventListener('keydown', onKey);
          zoomed = false;
          (window as unknown as { __ifyFocus?: (c: HTMLElement | null, k?: HTMLElement | null) => void }).__ifyFocus?.(
            card.getAttribute('tabindex') === '-1' ? canvas! : card,
            null,
          );
        };
        if (reduced.matches) finish();
        else window.setTimeout(finish, 400);
      }
      const onKey = (event: KeyboardEvent) => {
        if (event.key === 'Escape') done();
        if (event.key === 'Tab') {
          event.preventDefault();
          close.focus();
        }
      };
      close.addEventListener('click', done);
      backdrop.addEventListener('click', done);
      clone.addEventListener('click', done);
      document.addEventListener('keydown', onKey);
    }

    /* ----- Only drift while the board is on screen ----- */
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => (onScreen = entries.some((entry) => entry.isIntersecting))).observe(canvas);
    }

    new ResizeObserver(() => {
      measure();
      apply();
    }).observe(canvas);
    measure();
    apply();
    requestAnimationFrame((now) => {
      last = now;
      requestAnimationFrame(tick);
    });
  }
</script>
