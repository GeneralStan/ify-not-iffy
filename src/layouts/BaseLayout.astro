---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Pages with the animated hero hide it until hero-intro.ts plays the load-in. */
  intro?: boolean;
  /** Sets <html data-page>, which drives the page colour and the current flap. */
  page?: string;
}

const { title, description, intro = false, page } = Astro.props;
const exatExtraLight = withBase('/fonts/exatcyr-extralight.otf');
const exatLight = withBase('/fonts/exatcyr-light.otf');
const exatRegular = withBase('/fonts/exatcyr-regular.otf');
const exatMedium = withBase('/fonts/exatcyr-medium.otf');
const exatBold = withBase('/fonts/exatcyr-bold.otf');
const exatExtraBold = withBase('/fonts/exatcyr-extrabold.otf');
const exatBlack = withBase('/fonts/exatcyr-black.otf');
---

<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FEFFFA" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <style is:inline set:html={`
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR Extra Light"), url("${exatExtraLight}") format("opentype"); font-weight: 200; font-style: normal; font-display: swap; }
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR Light"), url("${exatLight}") format("opentype"); font-weight: 300; font-style: normal; font-display: swap; }
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR"), local("Exat CYR Regular"), url("${exatRegular}") format("opentype"); font-weight: 400; font-style: normal; font-display: swap; }
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR Medium"), url("${exatMedium}") format("opentype"); font-weight: 500; font-style: normal; font-display: swap; }
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR Bold"), url("${exatBold}") format("opentype"); font-weight: 700; font-style: normal; font-display: swap; }
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR Extra Bold"), url("${exatExtraBold}") format("opentype"); font-weight: 800; font-style: normal; font-display: swap; }
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR Black"), url("${exatBlack}") format("opentype"); font-weight: 900; font-style: normal; font-display: swap; }
    `}></style>
    {intro && <script is:inline>
      // Hide the hero for its load-in only when motion is allowed and JS runs, and only on the
      // first load: page changes keep the hero (ClientRouter), so it must not hide again.
      // hero-intro.ts removes the class; the timeout is a safety net.
      if (!window.__ifyIntroSeen && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        window.__ifyIntroSeen = true;
        document.documentElement.classList.add('intro-wait');
        setTimeout(function () { document.documentElement.classList.remove('intro-wait'); }, 3000);
      }
      // Scroll reveals (src/scripts/reveal.ts): content below the hero waits hidden only when motion
      // is allowed and the observer exists. Set before first paint so nothing flashes.
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-ready');
      }
    </script>}
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip text-label" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
