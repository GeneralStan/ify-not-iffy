---
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Home: the nav and hero are hidden until the load-in plays (inline script below). */
  intro?: boolean;
  /** Sets <html data-page>, which drives the page colour. */
  page?: string;
}

const { title, description, intro = false, page } = Astro.props;
const exatExtraLight = withBase('/fonts/exatcyr-extralight.woff2');
const exatLight = withBase('/fonts/exatcyr-light.woff2');
const exatRegular = withBase('/fonts/exatcyr-regular.woff2');
const exatMedium = withBase('/fonts/exatcyr-medium.woff2');
const exatBold = withBase('/fonts/exatcyr-bold.woff2');
const exatExtraBold = withBase('/fonts/exatcyr-extrabold.woff2');
const exatBlack = withBase('/fonts/exatcyr-black.woff2');
// Body font (nav name, "Scroll to view work"): the same hashed file fonts.css points at.
import geistSans from '../../node_modules/geist/dist/fonts/geist-sans/Geist-Variable.woff2?url';
---

<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FEFFFA" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <!-- Fetch the fonts the first screen needs straight away (Latin-only WOFF2, ~15KB each). -->
    <link rel="preload" href={exatRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistSans} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR Extra Light"), url("${exatExtraLight}") format("woff2"); font-weight: 200; font-style: normal; font-display: swap; }
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR Light"), url("${exatLight}") format("woff2"); font-weight: 300; font-style: normal; font-display: swap; }
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR"), local("Exat CYR Regular"), url("${exatRegular}") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR Medium"), url("${exatMedium}") format("woff2"); font-weight: 500; font-style: normal; font-display: swap; }
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR Bold"), url("${exatBold}") format("woff2"); font-weight: 700; font-style: normal; font-display: swap; }
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR Extra Bold"), url("${exatExtraBold}") format("woff2"); font-weight: 800; font-style: normal; font-display: swap; }
      @font-face { font-family: "Exat CYR"; src: local("Exat CYR Black"), url("${exatBlack}") format("woff2"); font-weight: 900; font-style: normal; font-display: swap; }
    `}></style>
    {intro && <script is:inline>
      // Home load-in (see "Hero load-in" in home.css). It runs from here, in the page itself, so it
      // never waits for the script bundle: everything starts hidden, then the nav slides down from
      // the top and the hero follows. It starts once the display font is ready (or after 1.2s at most),
      // and a 2.5s fallback plays the same animation rather than just showing things, so nothing pops.
      // Reduced motion: no intro.
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var root = document.documentElement;
        root.classList.add('intro-wait');
        var started = false;
        function start() {
          if (started) return;
          started = true;
          root.classList.add('intro-play');
          root.classList.remove('intro-wait');
          setTimeout(function () {
            var hedges = document.querySelector('[data-hedges="hero"]');
            if (hedges) hedges.classList.add('is-popped');
          }, 1150);
          setTimeout(function () { root.classList.remove('intro-play'); }, 4600);
        }
        function whenParsed() {
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
          else start();
        }
        var font = document.fonts && document.fonts.load ? document.fonts.load('400 56px "Exat CYR"') : Promise.resolve();
        Promise.race([font, new Promise(function (r) { setTimeout(r, 1200); })]).then(whenParsed, whenParsed);
        setTimeout(start, 2500);
      })();
    </script>}
    <script is:inline>
      // Input modality: remember whether the last interaction was the keyboard, so scripts that move
      // focus (opening a menu, sheet or image) only put it on a control (with its ring) for keyboard
      // users. After a tap or click they focus the overlay itself instead: screen readers still land
      // inside it, and no focus ring appears.
      (function () {
        var keys = /^(Tab|Enter| |Escape|Arrow)/;
        window.__ifyKeyboard = false;
        addEventListener('keydown', function (e) { if (keys.test(e.key)) window.__ifyKeyboard = true; }, true);
        addEventListener('pointerdown', function () { window.__ifyKeyboard = false; }, true);
        window.__ifyFocus = function (control, container) {
          var target = window.__ifyKeyboard || !container ? control : container;
          if (!target) return;
          if (target === container && !container.hasAttribute('tabindex')) container.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
        };
      })();
    </script>
    <script is:inline>
      // Open at the top. Safari (and in-app browsers like WhatsApp's) restore the last scroll position
      // when a link reopens a page or on reload, which landed visitors at Selected projects instead of
      // the hero. Fresh visits and reloads start at the top; Back/Forward still restore, and links
      // with a #section still jump to it. Restoration is switched back on after load so leaving and
      // returning with Back keeps working.
      (function () {
        try {
          var entry = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
          if (location.hash || (entry && entry.type === 'back_forward')) return;
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
          // Stop forcing the top as soon as the visitor scrolls on their own.
          var moved = false;
          ['wheel', 'touchstart', 'keydown'].forEach(function (type) {
            window.addEventListener(type, function () { moved = true; }, { once: true, passive: true });
          });
          var top = function () { if (!moved) window.scrollTo(0, 0); };
          top();
          window.addEventListener('DOMContentLoaded', top, { once: true });
          window.addEventListener('load', function () {
            top();
            setTimeout(function () { if ('scrollRestoration' in history) history.scrollRestoration = 'auto'; }, 0);
          }, { once: true });
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // Nav: the glass toolbar is the default. ?nav=flaps shows the original flaps instead and
      // ?nav=glass switches back; the choice is remembered in this browser.
      try {
        var navParam = new URLSearchParams(location.search).get('nav');
        if (navParam === 'glass' || navParam === 'flaps') localStorage.setItem('ify-nav', navParam);
        if (localStorage.getItem('ify-nav') !== 'flaps') document.documentElement.dataset.navstyle = 'glass';
      } catch (e) {
        if (!/[?&]nav=flaps/.test(location.search)) document.documentElement.dataset.navstyle = 'glass';
      }
    </script>
    <script is:inline>
      // Scroll reveals (src/scripts/reveal.ts): content waits hidden only when motion is allowed and
      // the observer exists. Set before first paint so nothing flashes.
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-ready');
      }
    </script>
    <title>{title}</title>
    <script is:inline>
      // Mobile case study sheet (src/scripts/case-sheet.ts): while a sheet is open, Back closes it,
      // and Forward into a sheet entry reopens it in place.
      window.addEventListener('popstate', function (event) {
        var sheet = window.__caseSheet;
        if (sheet && sheet.open) {
          event.stopImmediatePropagation();
          sheet.close(true);
        } else if (event.state && event.state.caseSheet && document.querySelector('[data-case-sheet]')) {
          event.stopImmediatePropagation();
          window.dispatchEvent(new Event('case-sheet:reopen'));
        }
      });
    </script>
  </head>
  <body>
    <a class="skip text-label" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
