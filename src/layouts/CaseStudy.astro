---
/**
 * Case study page, from Figma "Inner Page draft 1" (4058:1340). A page of its own (no site hero,
 * flaps or footer): a 56px rail with a close button back to Work, a 240px side nav, and a 1144px
 * content column (dark 480px header, then 944px sections).
 * Structure: docs/case-study-structure.md (Header, Overview, Defining the problem,
 * Design decisions, Learnings & reflections). Anything still "[TBD: …]" gets .is-tbd.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import StudyMedia from '../components/StudyMedia.astro';
import { withBase } from '../lib/url';
import '../styles/case-study.css';

interface Neighbor {
  id: string;
  data: { name: string };
}

interface Props {
  study: CollectionEntry<'work'>;
  prev?: Neighbor | null;
  next?: Neighbor | null;
}

const { study, prev = null, next = null } = Astro.props;
const { data } = study;
const tbd = (value: string) => value.includes('[TBD');

const facts = [
  ['Timeline', data.facts.timeline],
  ['Role', data.facts.role],
  ['Platform', data.facts.platform],
  ['Team', data.facts.team],
] as const;

const sections = [
  ['overview', 'Overview'],
  ['problem', 'Defining the problem'],
  ['decisions', 'Design decisions'],
  ['learnings', 'Learnings & reflections'],
] as const;

const workHref = withBase('/#work');
---

<BaseLayout page="work" title={`${data.name} — Ifeanyi Ulasika`} description={data.summary}>
  <a class="case-sheet-backdrop" href={workHref} data-astro-reload aria-label="Close, back to Work"></a>
  <div class="case-page" data-case-page>
    <div class="case-sheet__grab" data-sheet-grab aria-hidden="true"><span class="case-sheet__handle"></span></div>
    <div class="case-rail">
      <a class="case-close" href={workHref} data-astro-reload aria-label="Close, back to Work">
        <svg width="24" height="24" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" />
        </svg>
      </a>
    </div>

    <nav class="case-toc" aria-label="On this page">
      <ol class="case-toc__list">
        {sections.map(([id, label]) => (
          <li>
            <a class="case-toc__link" href={`#${id}`} data-toc-link={id}>{label}</a>
          </li>
        ))}
      </ol>
    </nav>

    <main class="case-main" id="content">
      <header class="case-header">
        <h1 class:list={['case-title text-title', tbd(data.title) && 'is-tbd']}>{data.title}</h1>
        <dl class="case-facts">
          {facts.map(([label, value]) => (
            <div>
              <dt class="text-meta">{label}</dt>
              <dd class:list={['text-body-lg', tbd(value) && 'is-tbd']}>{value}</dd>
            </div>
          ))}
        </dl>
      </header>

      <div class="case-body">
        <section class="case-section" id="overview" aria-labelledby="overview-title" data-toc-section>
          <div class="case-block case-block--lead">
            <h2 class="case-section__title text-h1" id="overview-title">Overview</h2>
            <p class:list={['case-text text-body-lg', tbd(data.overview.body) && 'is-tbd']}>{data.overview.body}</p>
          </div>
          <figure class="case-visual">
            <StudyMedia frame="hero" {...data.hero} />
          </figure>
          <div class="case-block case-block--tight">
            <p class="case-eyebrow text-meta-lg">Outcome</p>
            <p class:list={['case-statement text-h2', tbd(data.overview.outcome) && 'is-tbd']}>{data.overview.outcome}</p>
          </div>
        </section>

        <section class="case-section" id="problem" aria-labelledby="problem-title" data-toc-section>
          <div class="case-block case-block--lead">
            <h2 class="case-section__title text-h1" id="problem-title">Defining the problem</h2>
            <p class:list={['case-text text-body-lg', tbd(data.problem.body) && 'is-tbd']}>{data.problem.body}</p>
          </div>
          {
            data.problem.hmw && (
              <div class="case-block case-block--tight">
                <p class="case-eyebrow text-meta-lg">Problem statement</p>
                <p class:list={['case-statement case-statement--hmw text-h2', tbd(data.problem.hmw) && 'is-tbd']}>{data.problem.hmw}</p>
              </div>
            )
          }
          {
            data.problem.findings && data.problem.findings.length > 0 && (
              <div class="case-block">
                <h3 class="case-subhead text-h2">What we uncovered</h3>
                <ul class="findings">
                  {data.problem.findings.map((finding) => (
                    <li class="finding">
                      <h4 class:list={['finding__title text-h4', tbd(finding.title) && 'is-tbd']}>{finding.title}</h4>
                      <p class:list={['finding__body text-body', tbd(finding.body) && 'is-tbd']}>{finding.body}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          {data.problem.visuals.map((visual) => (
            <figure class="case-visual">
              <StudyMedia frame="slot" {...visual} />
              {visual.caption && <figcaption class="text-body">{visual.caption}</figcaption>}
            </figure>
          ))}
        </section>

        <section class="case-section" id="decisions" aria-labelledby="decisions-title" data-toc-section>
          <h2 class="case-section__title text-h1" id="decisions-title">Design decisions</h2>
          <ol class="decision-list">
            {data.decisions.map((item, index) => (
              <li class="decision" id={`decision-${index + 1}`}>
                <div class="case-block case-block--tight">
                  <p class="case-eyebrow text-meta-lg">Decision {index + 1}</p>
                  <h3 class:list={['case-subhead text-h2', tbd(item.title) && 'is-tbd']}>{item.title}</h3>
                </div>
                <dl class="decision__parts">
                  <div>
                    <dt class="text-h4">What was wrong</dt>
                    <dd class:list={['text-body', tbd(item.wrong) && 'is-tbd']}>{item.wrong}</dd>
                  </div>
                  {item.considered && item.considered.length > 0 && (
                    <div>
                      <dt class="text-h4">What I considered</dt>
                      <dd>
                        <ul class="considered">
                          {item.considered.map((option) => (
                            <li class="text-body">
                              <span class:list={['considered__name', tbd(option.name) && 'is-tbd']}>{option.name}</span>
                              {' '}
                              <span class:list={[tbd(option.reason) && 'is-tbd']}>{option.reason}</span>
                            </li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  )}
                  <div>
                    <dt class="text-h4">What I did</dt>
                    <dd class:list={['text-body', tbd(item.did) && 'is-tbd']}>{item.did}</dd>
                  </div>
                  <div>
                    <dt class="text-h4">Result</dt>
                    <dd class:list={['text-body', tbd(item.result) && 'is-tbd']}>{item.result}</dd>
                  </div>
                </dl>
                {item.visual && (
                  <figure class="case-visual">
                    <StudyMedia frame="slot" {...item.visual} />
                    {item.visual.caption && <figcaption class="text-body">{item.visual.caption}</figcaption>}
                  </figure>
                )}
              </li>
            ))}
          </ol>
        </section>

        <section class="case-section" id="learnings" aria-labelledby="learnings-title" data-toc-section>
          <div class="case-block case-block--lead">
            <h2 class="case-section__title text-h1" id="learnings-title">Learnings &amp; reflections</h2>
            {data.learnings.map((paragraph) => (
              <p class:list={['case-text text-body-lg', tbd(paragraph) && 'is-tbd']}>{paragraph}</p>
            ))}
          </div>
        </section>

        <nav class="case-pager" aria-label="Other case studies">
          {prev && (
            <a class="case-pager__move" href={withBase(`/work/${prev.id}/`)}>
              <span class="text-meta">Previous</span>
              <span class="case-pager__name text-h4">{prev.data.name}</span>
            </a>
          )}
          {next && (
            <a class="case-pager__move case-pager__move--next" href={withBase(`/work/${next.id}/`)}>
              <span class="text-meta">Next</span>
              <span class="case-pager__name text-h4">{next.data.name}</span>
            </a>
          )}
        </nav>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  /* Phones: the page is a sheet; drag it down (from the handle, or anywhere at the top of the page)
     to close it and go back to Work. */
  import { attachDrag } from '../scripts/case-sheet';

  const page = document.querySelector<HTMLElement>('[data-case-page]');
  const close = document.querySelector<HTMLAnchorElement>('.case-close');
  if (page && close && window.matchMedia('(max-width: 767px)').matches) {
    attachDrag(page, window, () => {
      page.style.translate = '0 100vh';
      window.setTimeout(() => (location.href = close.href), 250);
    });
  }

  /* Side nav: the section in view is the current link (Figma: Label/Medium, Neutral/950). */
  function bindToc() {
    const links = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((link) => links.set(link.dataset.tocLink!, link));
    const sections = document.querySelectorAll<HTMLElement>('[data-toc-section]');
    if (!links.size || !sections.length || !('IntersectionObserver' in window)) return;
    const setCurrent = (id: string) =>
      links.forEach((link, key) => (key === id ? link.setAttribute('aria-current', 'true') : link.removeAttribute('aria-current')));
    setCurrent(sections[0].id);
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting);
        if (visible.length) setCurrent(visible[0].target.id);
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }
  bindToc();
  document.addEventListener('astro:after-swap', bindToc);
</script>
