---
/**
 * Site pages (Figma "Portfolio" 4033:3766): Home, Work, Playground and About are separate pages.
 * Every page has the top nav bar and the footer; only Home has the hero.
 * Plain page loads (no client router), so each page ships only what it needs.
 */
import BaseLayout from './BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteHero from '../components/SiteHero.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { PageId } from '../data/site';
import '../styles/home.css';
import '../styles/reveal.css';
import '../styles/pages.css';
import '../styles/case-study.css';

interface Props {
  page: PageId;
  title: string;
  description: string;
  /** A case study page: Home is drawn underneath an overlay, so no load-in. */
  overlay?: boolean;
}

const { page, title, description, overlay = false } = Astro.props;
---

<BaseLayout intro={page === 'home' && !overlay} page={page} title={title} description={description}>
  <SiteNav current={page} />
  {page === 'home' && <SiteHero />}
  <main id="content" class={`page-body page-body--${page}`}>
    <slot />
  </main>
  <SiteFooter />
  <slot name="overlay" />
</BaseLayout>

<script>
  import '../scripts/reveal';
  import '../scripts/skeleton';
  import '../scripts/cursor-tooltip';
  import '../scripts/cal';
  import '../scripts/case-sheet';
</script>
