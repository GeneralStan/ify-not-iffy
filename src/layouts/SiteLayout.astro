---
/**
 * Every page has the same frame: hero, flap nav, page body, footer.
 * Hero, nav and footer are persisted across page changes (Astro ClientRouter), so switching pages
 * only swaps the body: the flaps animate to the new current page and the page colour changes.
 */
import BaseLayout from './BaseLayout.astro';
import FlapNav from '../components/FlapNav.astro';
import SiteHero from '../components/SiteHero.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { PageId } from '../data/site';
import '../styles/home.css';
import '../styles/reveal.css';
import '../styles/pages.css';
import '../styles/case-study.css';

interface Props {
  page: PageId;
  title: string;
  description: string;
  /** Open scrolled past the hero with the flaps docked (case study pages). */
  land?: 'docked';
  /** Extra class on <main>. */
  bodyClass?: string;
}

const { page, title, description, land, bodyClass } = Astro.props;
---

<BaseLayout intro page={page} land={land} title={title} description={description}>
  <SiteHero />
  <FlapNav current={page} />
  <main id="content" class:list={['page-body', `page-body--${page}`, bodyClass]} transition:animate="fade">
    <slot />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import '../scripts/hero-intro';
  import '../scripts/reveal';
  import '../scripts/cursor-tooltip';
  import '../scripts/cal';
</script>
